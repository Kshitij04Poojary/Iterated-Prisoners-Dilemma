    "\n",
    "def _plot_confidence_gating(eval_results, output_dir):\n",
    "    \"\"\"\n",
    "    CHANGE 2 diagnostic: per-round reward split by early (rounds 1-10)\n",
    "    vs late (rounds 41-100) for original vs hard opponents.\n",
    "    The confidence gate should close the early>late gap.\n",
    "    \"\"\"\n",
    "    if 'DRQN+v9r' not in eval_results: return\n",
    "\n",
    "    orig_opps=[o for o in OPPONENT_NAMES[:N_ORIGINAL] if o in eval_results['DRQN+v9r']]\n",
    "    hard_opps=[o for o in OPPONENT_NAMES[N_ORIGINAL:]  if o in eval_results['DRQN+v9r']]\n",
    "\n",
    "    fig,axes=plt.subplots(1,2,figsize=(14,5))\n",
    "    colors={'DRQN+v9r':'#1565C0','Bare DQN':'#EF5350','TFT':'#43A047'}\n",
    "\n",
    "    for ax,opp_set,title in [(axes[0],orig_opps,\"Original 20\"),(axes[1],hard_opps,\"Hard 8\")]:\n",
    "        for ag in ['DRQN+v9r','Bare DQN','TFT']:\n",
    "            if ag not in eval_results or not opp_set: continue\n",
    "            curve=np.mean([eval_results[ag][o]['round_reward'] for o in opp_set],axis=0)\n",
    "            rounds=np.arange(1,ROUNDS_PER_EPISODE+1)\n",
    "            ax.plot(rounds,np.convolve(curve,np.ones(5)/5,mode='same'),\n",
    "                    label=ag,color=colors.get(ag,'gray'),lw=2)\n",
    "        ax.set_title(f\"Per-round reward — {title}\"); ax.set_xlabel(\"Round\")\n",
    "        ax.set_ylabel(\"Mean reward\"); ax.legend(fontsize=9); ax.grid(alpha=0.3)\n",
    "        # Shade the three adaptation windows (every META_ADAPT_FREQ rounds)\n",
    "        for i in range(3):\n",
    "            lo = i * META_ADAPT_FREQ + 1\n",
    "            hi = lo + META_ADAPT_FREQ\n",
    "            ax.axvspan(lo, hi, alpha=0.05, color=['green','blue','purple'][i])\n",
    "\n",
    "    plt.tight_layout()\n",
    "    show_figure(f'{output_dir}/08_confidence_gating.png',\"Confidence Gating Diagnostic\")\n",
    "\n",
