    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# PLOTS\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "def plot_all(train_stats, eval_results, regret_dict, embeddings_data=None,\n",
    "             output_dir='/kaggle/working'):\n",
    "    os.makedirs(output_dir, exist_ok=True)\n",
    "    sns.set_style(\"whitegrid\")\n",
    "\n",
    "    COLORS={\n",
    "        'DRQN+v9r':    '#1565C0',\n",
    "        'Bare DQN':   '#EF5350',\n",
    "        'TFT':        '#43A047',\n",
    "        'Cooperator': '#FFA726',\n",
    "        'Defector':   '#78909C',\n",
    "    }\n",
    "\n",
    "    agents_list=list(eval_results.keys())\n",
    "    opps       =list(eval_results[agents_list[0]].keys())\n",
    "    orig_opps  =[o for o in opps if o in OPPONENT_NAMES[:N_ORIGINAL]]\n",
    "    hard_opps  =[o for o in opps if o in OPPONENT_NAMES[N_ORIGINAL:]]\n",
    "    learners   =[a for a in ['DRQN+v9r','Bare DQN'] if a in agents_list]\n",
    "    all_agents =[a for a in agents_list if a in COLORS]\n",
    "\n",
    "    def sm(arr,w=50):\n",
    "        return np.convolve(arr,np.ones(w)/w,mode='valid') if len(arr)>=w else arr\n",
    "\n",
    "    # 1. Training curves\n",
    "    fig,axes=plt.subplots(1,2,figsize=(15,5))\n",
    "    for name in learners:\n",
    "        if name not in train_stats: continue\n",
    "        c=COLORS.get(name,'gray')\n",
    "        axes[0].plot(sm(train_stats[name]['rewards'],80), label=name,color=c,lw=2)\n",
    "        axes[1].plot(sm(train_stats[name]['coop_rates'],80),label=name,color=c,lw=2)\n",
    "    for ax,title,ylabel in zip(axes,\n",
    "        [\"Training reward (smoothed w=80)\",\"Cooperation rate (smoothed)\"],\n",
    "        [\"Total reward\",\"Cooperation rate\"]):\n",
    "        ax.set_xlabel(\"Episode\"); ax.set_ylabel(ylabel)\n",
    "        ax.set_title(title); ax.legend(fontsize=9); ax.grid(alpha=0.3)\n",
    "    plt.tight_layout()\n",
    "    show_figure(f'{output_dir}/01_training_curves.png',\"Training Curves\")\n",
    "\n",
    "    # 2. Per-round adaptation\n",
    "    fig,axes=plt.subplots(1,2,figsize=(16,6))\n",
    "    rounds=np.arange(1,ROUNDS_PER_EPISODE+1)\n",
    "    for panel,opp_set,title in [\n",
    "        (axes[0],opps,     \"Per-round reward — ALL opponents\"),\n",
    "        (axes[1],hard_opps,\"Per-round reward — HARD opponents\"),\n",
    "    ]:\n",
    "        for name in learners+['TFT']:\n",
    "            if name not in eval_results or not opp_set: continue\n",
    "            mean_curve=np.mean([eval_results[name][o]['round_reward'] for o in opp_set],axis=0)\n",
    "            sm_curve  =np.convolve(mean_curve,np.ones(5)/5,mode='same')\n",
    "            panel.plot(rounds,sm_curve,label=name,color=COLORS.get(name,'gray'),lw=2)\n",
    "        panel.axvspan(1,10,alpha=0.07,color='gold',label='Early (1-10)')\n",
    "        panel.set_title(title); panel.set_xlabel(\"Round\")\n",
    "        panel.set_ylabel(\"Mean reward\"); panel.legend(fontsize=8); panel.grid(alpha=0.3)\n",
    "    plt.tight_layout()\n",
    "    show_figure(f'{output_dir}/02_per_round_adaptation.png',\"Per-Round Adaptation\")\n",
    "\n",
    "    # 3. Ablation bar\n",
    "    abl_present=[a for a in ['DRQN+v9r','Bare DQN','TFT','Cooperator','Defector']\n",
    "                 if a in agents_list]\n",
    "    fig,axes=plt.subplots(1,2,figsize=(14,6))\n",
    "    for ax,opp_set,title in [\n",
    "        (axes[0],opps,     \"Mean reward — All 28 opponents\"),\n",
    "        (axes[1],hard_opps,\"Mean reward — Hard 8 opponents\"),\n",
    "    ]:\n",
    "        means=[np.mean([eval_results[ag][o]['avg_reward']\n",
    "                        for o in opp_set if o in eval_results[ag]]) for ag in abl_present]\n",
    "        stds =[np.std([eval_results[ag][o]['avg_reward']\n",
    "                       for o in opp_set if o in eval_results[ag]])/np.sqrt(max(1,len(opp_set)))\n",
    "               for ag in abl_present]\n",
    "        bars=ax.bar(range(len(abl_present)),means,yerr=stds,capsize=4,\n",
    "                    color=[COLORS.get(a,'gray') for a in abl_present],\n",
    "                    edgecolor='white',linewidth=1.2)\n",
    "        ax.set_xticks(range(len(abl_present)))\n",
    "        ax.set_xticklabels(abl_present,rotation=20,ha='right',fontsize=9)\n",
    "        ax.set_ylabel(\"Mean episode reward\"); ax.set_title(title); ax.grid(axis='y',alpha=0.3)\n",
    "        for bar,m in zip(bars,means):\n",
    "            ax.text(bar.get_x()+bar.get_width()/2, m+1,\n",
    "                    f\"{m:.0f}\", ha='center',va='bottom',fontsize=9,fontweight='bold')\n",
    "    plt.tight_layout()\n",
    "    show_figure(f'{output_dir}/03_ablation_bar.png',\"Ablation — Mean Reward\")\n",
    "\n",
    "    # 4. Early vs late\n",
    "    fig,axes=plt.subplots(1,2,figsize=(14,6))\n",
    "    for ax_i,(phase,sl) in enumerate([\n",
    "        (\"Rounds 1-10 (adaptation)\",   slice(0,10)),\n",
    "        (\"Rounds 41-100 (steady state)\",slice(40,100)),\n",
    "    ]):\n",
    "        means=[np.mean([eval_results[ag][o]['round_reward'][sl].mean()\n",
    "                        for o in opps if o in eval_results[ag]]) for ag in abl_present]\n",
    "        axes[ax_i].bar(range(len(abl_present)),means,\n",
    "                       color=[COLORS.get(a,'gray') for a in abl_present],\n",
    "                       edgecolor='white',linewidth=1.2)\n",
    "        axes[ax_i].set_xticks(range(len(abl_present)))\n",
    "        axes[ax_i].set_xticklabels(abl_present,rotation=20,ha='right',fontsize=9)\n",
    "        axes[ax_i].set_ylabel(\"Mean reward per round\")\n",
    "        axes[ax_i].set_title(phase); axes[ax_i].grid(axis='y',alpha=0.3)\n",
    "        for j,(bar,m) in enumerate(zip(axes[ax_i].patches,means)):\n",
    "            axes[ax_i].text(bar.get_x()+bar.get_width()/2, m+0.02,\n",
    "                            f\"{m:.2f}\",ha='center',va='bottom',fontsize=9)\n",
    "    plt.tight_layout()\n",
    "    show_figure(f'{output_dir}/04_early_vs_late.png',\"Early vs Late\")\n",
    "\n",
    "    # 5. Per-opponent bar\n",
    "    plot_agents=[a for a in ['DRQN+v9r','Bare DQN','TFT'] if a in agents_list]\n",
    "    fig,ax=plt.subplots(figsize=(22,8))\n",
    "    x=np.arange(len(opps)); width=0.28\n",
    "    for i,ag in enumerate(plot_agents):\n",
    "        vals=[eval_results[ag][o]['avg_reward'] for o in opps]\n",
    "        errs=[eval_results[ag][o]['std_reward']  for o in opps]\n",
    "        ax.bar(x+i*width,vals,width,yerr=errs,label=ag,capsize=2,\n",
    "               alpha=0.85,color=COLORS.get(ag,f'C{i}'))\n",
    "    ax.axvline(N_ORIGINAL-0.5,color='black',ls='--',lw=1.5,alpha=0.5,label='Original | Hard split')\n",
    "    ax.set_xticks(x+width); ax.set_xticklabels([o[:18] for o in opps],rotation=45,ha='right',fontsize=7.5)\n",
    "    ax.set_ylabel(\"Average reward\"); ax.set_title(\"Per-opponent performance\")\n",
    "    ax.legend(); ax.grid(axis='y',alpha=0.3)\n",
    "    plt.tight_layout()\n",
    "    show_figure(f'{output_dir}/05_per_opponent.png',\"Per-Opponent Performance\")\n",
    "\n",
    "    # 6. Regret heatmap\n",
    "    rm=[[regret_dict[ag][o] for o in opps] for ag in all_agents if ag in regret_dict]\n",
    "    row_labels=[ag for ag in all_agents if ag in regret_dict]\n",
    "    fig,ax=plt.subplots(figsize=(20,max(4,len(row_labels)*0.9)))\n",
    "    im=ax.imshow(rm,cmap='RdYlGn_r',aspect='auto',vmin=0,vmax=200)\n",
    "    ax.set_xticks(np.arange(len(opps))); ax.set_yticks(np.arange(len(row_labels)))\n",
    "    ax.set_xticklabels([o[:15] for o in opps],rotation=45,ha='right',fontsize=7)\n",
    "    ax.set_yticklabels(row_labels,fontsize=9)\n",
