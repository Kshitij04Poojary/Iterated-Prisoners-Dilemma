    "            print(f\"\\n  {opp_group}:\")\n",
    "            for abl in ablations:\n",
    "                abl_mean=np.mean([eval_results_dict[abl][o]['avg_reward']\n",
    "                                  for o in opp_list if o in opps])\n",
    "                delta=full_mean-abl_mean\n",
    "                bar='▲'*int(abs(delta)/2) if delta>0 else '▼'*int(abs(delta)/2)\n",
    "                print(f\"    {full} − {abl:<35} Δ={delta:+.1f}  {bar}\")\n",
    "\n",
    "    print(f\"\\n{'─'*80}\")\n",
    "    print(\"ADAPTATION SPEED  (mean reward rounds 1-10 vs 41-100)\")\n",
    "    print(f\"{'─'*80}\")\n",
