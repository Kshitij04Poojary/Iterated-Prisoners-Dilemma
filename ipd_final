    "\"\"\"\n",
    "================================================================================\n",
    "GRU-DQN / Transformer-DQN with Action-Conditioned Contrastive Learning — v9r\n",
    "================================================================================\n",
    "\n",
    "v9 post-mortem and what this file fixes:\n",
    "  v9 collapsed on grudger-type opponents (Grudger: 300→115, MemoryDecayTFT:\n",
    "  300→124, DelayedGrudger: 300→127). Root cause: the zero-sum advantage\n",
    "  shaping (exp_r - mean) combined with λ=0.5 created a strong defection bias\n",
    "  before the Bayesian posterior had accumulated enough evidence. The model\n",
    "  committed to \"defect is better\" on round 2-3 and never recovered against\n",
    "  opponents that punish defection harshly. The confidence gate made it worse:\n",
    "  low early confidence → near-zero shaping → Q-head dominated → defect reflex\n",
    "  from training distribution noise.\n",
    "\n",
    "Changes from v8 (the working baseline):\n",
    "\n",
    "CHANGE 1 — Calibrated shaping strength (replaces v9's zero-sum adventure)\n",
    "  - Keep v8's raw exp_r shaping: q_shaped = q + λ * exp_r\n",
    "  - But expose λ as a swept parameter rather than a fixed constant\n",
    "  - Optimal range identified from v8 vs v9 failure analysis: 0.20–0.30\n",
    "  - Default: SHAPE_LAMBDA = 0.25 (between v8's 0.3 and a safer 0.2)\n",
    "  - Why not zero-sum: raw exp_r is always positive — it lifts the better\n",
    "    action without actively depressing the other, which is safer when the\n",
    "    posterior is still uncertain\n",
    "\n",
    "CHANGE 2 — Soft confidence gate with power calibration\n",
    "  - Confidence gate is correct in concept (v9), wrong in magnitude\n",
    "  - Fix: apply a power > 1 so the gate opens more slowly\n",
    "       confidence = (1 - H/log(N))^power,  power=2.0\n",
    "  - power=1.0 (v9): gates to 0.5 confidence when H=50% max entropy\n",
    "  - power=2.0 (this): gates to 0.25 at same entropy → delayed commitment\n",
    "  - Gate is now applied to the FULL exp_r (not zero-sum advantage), so\n",
    "    even at full confidence the shaping remains cooperative-biased\n",
    "  - CONFIDENCE_POWER is a tunable parameter (1.0, 1.5, 2.0)\n",
    "\n",
    "CHANGE 3 — Restored v8 meta-learning params + targeted parameter selection\n",
    "  - freq: back to 15 (v8) — 10 was over-adapting\n",
    "  - steps: back to 3 (v8)\n",
    "  - lr: back to 3e-4 (v8)\n",
    "  - Structural improvement from v9 RETAINED: meta-adapt only touches\n",
    "    fast_encoder + shared + Q-heads (slow transformer frozen)\n",
    "    This part was correct in v9. The meta params were the bug.\n",
    "\n",
    "CHANGE 4 — All v8 components fully retained:\n",
    "  EpisodeTransformer, 28-class Bayesian posterior, Fast/Slow dual stream,\n",
    "  InfoNCE contrastive loss (same-opponent positives), all 6 v7 fixes,\n",
    "  gamma=0.98, batch=256, tau=0.03, window=30\n",
    "\n",
    "================================================================================\n",
    "Ablation instructions for paper:\n",
    "  v9r-noGate:   set CONFIDENCE_POWER=0 (gate always 1, pure v8 shaping)\n",
    "  v9r-rawLam:   set SHAPE_LAMBDA=0.3 (v8 value, no calibration)\n",
    "  v9r-allMeta:  unfreeze slow_encoder in MetaAdapter (revert structural fix)\n",
    "\n",
    "Expected ordering on hard opponents:\n",
    "  v9r > v9r-noGate ≈ v8 > v9r-allMeta > v9\n",
    "================================================================================\n",
    "\"\"\"\n",
    "\n",
    "import random, os, time, json, warnings, copy\n",
    "import numpy as np\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "import torch.optim as optim\n",
    "import torch.nn.functional as F\n",
    "from collections import deque, namedtuple\n",
    "from dataclasses import dataclass\n",
    "from typing import List, Tuple, Optional\n",
    "import matplotlib\n",
    "matplotlib.use('Agg')\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from tqdm.auto import tqdm\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "try:\n",
    "    from IPython.display import display, Image as IPImage\n",
    "    _IN_NOTEBOOK = True\n",
    "except ImportError:\n",
    "    _IN_NOTEBOOK = False\n",
    "\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# GLOBALS\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "SEED = 42\n",
    "random.seed(SEED); np.random.seed(SEED)\n",
    "torch.manual_seed(SEED); torch.cuda.manual_seed_all(SEED)\n",
    "torch.backends.cudnn.deterministic = True\n",
    "torch.backends.cudnn.benchmark     = False\n",
    "\n",
    "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "print(f\"[INFO] Device: {device} | SEED={SEED}\")\n",
    "\n",
    "C, D = 0, 1\n",
    "ROUNDS_PER_EPISODE   = 100\n",
    "ACTION_DIM           = 2\n",
    "TRAIN_FREQ           = 4\n",
    "\n",
    "TRANSFORMER_WINDOW   = 30\n",
    "FAST_WINDOW          = 5\n",
    "\n",
    "# CHANGE 3: restored v8 meta params (v9's tightening caused over-adaptation)\n",
    "META_ADAPT_FREQ      = 15      # v8 value restored\n",
    "META_WINDOW          = 20\n",
    "META_STEPS           = 3       # v8 value restored\n",
    "META_LR              = 3e-4    # v8 value restored\n",
    "\n",
    "PAYOFF = {(C,C):(3,3), (C,D):(0,5), (D,C):(5,0), (D,D):(1,1)}\n",
    "PAYOFF_TENSOR = torch.tensor([[3., 0.], [5., 1.]])\n",
    "\n",
    "# CHANGE 1: calibrated shaping — raw exp_r (cooperative bias preserved), λ=0.25\n",
    "# v8 used 0.3 (slightly too strong), v9 used 0.5 zero-sum (collapsed grudgers)\n",
    "SHAPE_LAMBDA      = 0.25\n",
    "\n",
    "# CHANGE 2: soft confidence gate power — delays commitment to posterior\n",
    "# power=1.0 → linear gate (v9, too aggressive)\n",
    "# power=2.0 → quadratic gate (safer, ~round 25-30 commitment)\n",
    "CONFIDENCE_POWER  = 2.0\n",
    "\n",
    "SeqTransition = namedtuple('SeqTransition',\n",
    "    ('seq', 'base_obs', 'action', 'reward', 'next_seq', 'next_base_obs', 'done', 'h0'))\n",
    "\n",
    "def show_figure(path, title=\"\"):\n",
    "    plt.savefig(path, dpi=150, bbox_inches='tight')\n",
    "    plt.close()\n",
    "    if _IN_NOTEBOOK:\n",
    "        print(f\"\\n{'─'*55}\\n  {title}\\n{'─'*55}\")\n",
    "        display(IPImage(filename=path))\n",
    "    print(f\"  Saved → {os.path.basename(path)}\")\n",
    "\n",
    "\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# OPPONENT POOL (identical to v8)\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "class Strategy:\n",
    "    def reset(self): pass\n",
    "    def move(self, my_hist, opp_hist) -> int: raise NotImplementedError\n",
    "    @property\n",
    "    def name(self): return self.__class__.__name__\n",
    "\n",
    "class TitForTat(Strategy):\n",
    "    def move(self, my_hist, opp_hist): return opp_hist[-1] if opp_hist else C\n",
    "\n",
    "class Cooperator(Strategy):\n",
    "    def move(self, my_hist, opp_hist): return C\n",
    "\n",
    "class Defector(Strategy):\n",
    "    def move(self, my_hist, opp_hist): return D\n",
    "\n",
    "class WinStayLoseShift(Strategy):\n",
    "    def move(self, my_hist, opp_hist):\n",
    "        if not my_hist: return C\n",
    "        won = (my_hist[-1]==C and opp_hist[-1]==C) or (my_hist[-1]==D and opp_hist[-1]==C)\n",
    "        return my_hist[-1] if won else (D if my_hist[-1]==C else C)\n",
    "\n",
    "class WinShiftLoseStay(Strategy):\n",
    "    def move(self, my_hist, opp_hist):\n",
    "        if not my_hist: return D\n",
    "        won = (my_hist[-1]==C and opp_hist[-1]==C) or (my_hist[-1]==D and opp_hist[-1]==C)\n",
    "        return (D if my_hist[-1]==C else C) if won else my_hist[-1]\n",
    "\n",
    "class RandomStrategy(Strategy):\n",
    "    @property\n",
    "    def name(self): return \"Random\"\n",
    "    def move(self, my_hist, opp_hist): return random.choice([C,D])\n",
    "\n",
    "class Grudger(Strategy):\n",
    "    def __init__(self): self._triggered = False\n",
    "    def reset(self): self._triggered = False\n",
    "    def move(self, my_hist, opp_hist):\n",
    "        if D in opp_hist: self._triggered = True\n",
    "        return D if self._triggered else C\n",
    "\n",
    "class SuspiciousTFT(Strategy):\n",
    "    def move(self, my_hist, opp_hist): return D if not opp_hist else opp_hist[-1]\n",
    "\n",
    "class HardTFT2(Strategy):\n",
    "    def move(self, my_hist, opp_hist):\n",
    "        if len(opp_hist)>=2 and opp_hist[-1]==D and opp_hist[-2]==D: return D\n",
    "        return C\n",
    "\n",
    "class Prober(Strategy):\n",
    "    def __init__(self): self._exploit = None\n",
    "    def reset(self): self._exploit = None\n",
    "    def move(self, my_hist, opp_hist):\n",
    "        t = len(my_hist)\n",
    "        if t==0: return D\n",
    "        if t in (1,2): return C\n",
    "        if t==3: self._exploit = (opp_hist[1]==C and opp_hist[2]==C)\n",
    "        return D if self._exploit else opp_hist[-1]\n",
    "\n",
    "class GTFT(Strategy):\n",
    "    def __init__(self, p=0.33): self.p = p\n",
    "    def move(self, my_hist, opp_hist):\n",
    "        if not opp_hist or opp_hist[-1]==C: return C\n",
    "        return C if random.random()<self.p else D\n",
    "\n",
    "class Forgiver(Strategy):\n",
    "    def __init__(self, threshold=0.1): self.threshold = threshold\n",
    "    def move(self, my_hist, opp_hist):\n",
    "        if not opp_hist: return C\n",
    "        return D if opp_hist.count(D)/len(opp_hist)>self.threshold else C\n",
    "\n",
    "class NoisyTFT(Strategy):\n",
    "    def __init__(self, noise=0.05): self.noise = noise\n",
    "    def move(self, my_hist, opp_hist):\n",
    "        intended = opp_hist[-1] if opp_hist else C\n",
    "        return 1-intended if random.random()<self.noise else intended\n",
    "\n",
    "class NoisyWSLS(Strategy):\n",
    "    def __init__(self, noise=0.05): self.noise = noise\n",
    "    def move(self, my_hist, opp_hist):\n",
    "        if not my_hist: intended=C\n",
    "        else:\n",
    "            won=(my_hist[-1]==C and opp_hist[-1]==C) or (my_hist[-1]==D and opp_hist[-1]==C)\n",
    "            intended=my_hist[-1] if won else (D if my_hist[-1]==C else C)\n",
    "        return 1-intended if random.random()<self.noise else intended\n",
    "\n",
    "class RegimeSwitcher(Strategy):\n",
    "    def __init__(self, switch_round=50): self.switch_round = switch_round\n",
    "    def move(self, my_hist, opp_hist): return C if len(my_hist)<self.switch_round else D\n",
    "\n",
    "class AdaptiveDefector(Strategy):\n",
    "    def __init__(self, exploit_threshold=0.7):\n",
    "        self.threshold=exploit_threshold; self.phase=\"cooperate\"; self.coop_count=0\n",
    "    def reset(self): self.phase=\"cooperate\"; self.coop_count=0\n",
    "    def move(self, my_hist, opp_hist):\n",
    "        t=len(my_hist)\n",
    "        if t==0: self.reset(); return C\n",
    "        if my_hist[-1]==C: self.coop_count+=1\n",
    "        if t>=10 and (self.coop_count/t)>self.threshold: self.phase=\"defect\"\n",
    "        return D if self.phase==\"defect\" else C\n",
    "\n",
    "class HMMOpponent(Strategy):\n",
    "    def __init__(self, switch_prob=0.05): self.switch_prob=switch_prob; self.state=\"TFT\"\n",
    "    def reset(self): self.state=\"TFT\"\n",
    "    def move(self, my_hist, opp_hist):\n",
    "        if random.random()<self.switch_prob:\n",
    "            self.state=\"Defector\" if self.state==\"TFT\" else \"TFT\"\n",
    "        return (opp_hist[-1] if opp_hist else C) if self.state==\"TFT\" else D\n",
    "\n",
    "class SoftTFT(Strategy):\n",
    "    def __init__(self, p_coop=0.9): self.p = p_coop\n",
    "    def move(self, my_hist, opp_hist):\n",
    "        if not opp_hist: return C\n",
    "        coop_prob = self.p if opp_hist[-1]==C else (1-self.p)\n",
    "        return C if random.random()<coop_prob else D\n",
    "\n",
    "class LogisticStrategy(Strategy):\n",
    "    @property\n",
    "    def name(self): return \"Logistic\"\n",
    "    def __init__(self, w1=1.0, w2=-0.5): self.w1=w1; self.w2=w2\n",
    "    def move(self, my_hist, opp_hist):\n",
    "        if not my_hist or not opp_hist: return C\n",
    "        logit = self.w1*(1-2*my_hist[-1]) + self.w2*(1-2*opp_hist[-1])\n",
    "        return C if random.random()<1/(1+np.exp(-logit)) else D\n",
    "\n",
    "class DelayedGrudger(Strategy):\n",
    "    def __init__(self, delay=3): self.delay=delay; self.defections_seen=0\n",
    "    def reset(self): self.defections_seen=0\n",
    "    def move(self, my_hist, opp_hist):\n",
    "        if opp_hist and opp_hist[-1]==D: self.defections_seen+=1\n",
    "        return D if self.defections_seen>=self.delay else C\n",
    "\n",
    "class MemoryDecayTFT(Strategy):\n",
    "    @property\n",
    "    def name(self): return \"MemoryDecayTFT\"\n",
    "    def __init__(self, decay=0.85, threshold=0.4):\n",
    "        self.decay=decay; self.threshold=threshold; self.grudge=0.0\n",
    "    def reset(self): self.grudge=0.0\n",
    "    def move(self, my_hist, opp_hist):\n",
    "        self.grudge *= self.decay\n",
    "        if opp_hist and opp_hist[-1]==D:\n",
    "            self.grudge = min(1.0, self.grudge+0.4)\n",
    "        return D if self.grudge>self.threshold else C\n",
    "\n",
    "class TriggeredSwitcher(Strategy):\n",
    "    @property\n",
    "    def name(self): return \"TriggeredSwitcher\"\n",
    "    def __init__(self, k=3): self.k=k; self.defect_streak=0; self.switched=False\n",
    "    def reset(self): self.defect_streak=0; self.switched=False\n",
    "    def move(self, my_hist, opp_hist):\n",
    "        if opp_hist and opp_hist[-1]==D: self.defect_streak+=1\n",
    "        else: self.defect_streak=0\n",
    "        if self.defect_streak>=self.k: self.switched=True\n",
    "        if self.switched: return D\n",
    "        return opp_hist[-1] if opp_hist else C\n",
    "\n",
    "class MixedMotivation(Strategy):\n",
    "    @property\n",
    "    def name(self): return \"MixedMotivation\"\n",
    "    def __init__(self): self.p_tft=0.5\n",
    "    def reset(self): self.p_tft=random.uniform(0.2,0.8)\n",
    "    def move(self, my_hist, opp_hist):\n",
    "        if not my_hist: return C\n",
    "        if random.random()<self.p_tft:\n",
    "            return opp_hist[-1] if opp_hist else C\n",
    "        else:\n",
    "            won=(my_hist[-1]==C and opp_hist[-1]==C) or (my_hist[-1]==D and opp_hist[-1]==C)\n",
    "            return my_hist[-1] if won else (D if my_hist[-1]==C else C)\n",
    "\n",
    "class PeriodicStrategy(Strategy):\n",
    "    @property\n",
    "    def name(self): return \"PeriodicStrategy\"\n",
    "    def __init__(self): self.T=10\n",
    "    def reset(self): self.T=random.randint(5,20)\n",
    "    def move(self, my_hist, opp_hist):\n",
    "        t=len(my_hist); block=(t//self.T)%2\n",
    "        return C if block==0 else D\n",
    "\n",
    "class BayesianMimic(Strategy):\n",
    "    @property\n",
    "    def name(self): return \"BayesianMimic\"\n",
    "    def __init__(self, window=15): self.window=window\n",
    "    def move(self, my_hist, opp_hist):\n",
    "        if not opp_hist: return C\n",
    "        window=opp_hist[-self.window:]\n",
    "        p_coop=sum(1-a for a in window)/len(window)\n",
    "        return C if random.random()<p_coop else D\n",
    "\n",
    "class EscalatingDefector(Strategy):\n",
    "    @property\n",
    "    def name(self): return \"EscalatingDefector\"\n",
    "    def move(self, my_hist, opp_hist):\n",
    "        t=len(my_hist); p_defect=t/ROUNDS_PER_EPISODE\n",
    "        return D if random.random()<p_defect else C\n",
    "\n",
    "class ConditionalGrudger(Strategy):\n",
    "    @property\n",
    "    def name(self): return \"ConditionalGrudger\"\n",
    "    def __init__(self): self.triggered=False\n",
    "    def reset(self): self.triggered=False\n",
    "    def move(self, my_hist, opp_hist):\n",
    "        if my_hist and opp_hist:\n",
    "            if my_hist[-1]==C and opp_hist[-1]==D: self.triggered=True\n",
    "        return D if self.triggered else C\n",
    "\n",
    "class TwoTimidOneDevious(Strategy):\n",
    "    @property\n",
    "    def name(self): return \"TwoTimidOneDevious\"\n",
    "    def move(self, my_hist, opp_hist):\n",
    "        t=len(my_hist)\n",
    "        if t<int(ROUNDS_PER_EPISODE*0.67):\n",
    "            return opp_hist[-1] if opp_hist else C\n",
    "        return D\n",
    "\n",
    "ORIGINAL_OPPONENT_CLASSES = [\n",
    "    TitForTat, Cooperator, Defector, WinStayLoseShift, WinShiftLoseStay,\n",
    "    RandomStrategy, Grudger, SuspiciousTFT, HardTFT2, Prober, GTFT, Forgiver,\n",
    "    NoisyTFT, NoisyWSLS, RegimeSwitcher, AdaptiveDefector, SoftTFT,\n",
    "    LogisticStrategy, DelayedGrudger, HMMOpponent\n",
    "]\n",
    "HARD_OPPONENT_CLASSES = [\n",
    "    MemoryDecayTFT, TriggeredSwitcher, MixedMotivation, PeriodicStrategy,\n",
    "    BayesianMimic, EscalatingDefector, ConditionalGrudger, TwoTimidOneDevious\n",
    "]\n",
    "OPPONENT_CLASSES = ORIGINAL_OPPONENT_CLASSES + HARD_OPPONENT_CLASSES\n",
    "OPPONENT_NAMES   = [cls().name for cls in OPPONENT_CLASSES]\n",
    "N_OPPONENTS      = len(OPPONENT_NAMES)\n",
    "N_ORIGINAL       = len(ORIGINAL_OPPONENT_CLASSES)\n",
    "N_HARD           = len(HARD_OPPONENT_CLASSES)\n",
    "\n",
    "print(f\"[INFO] Total opponent pool: {N_OPPONENTS} ({N_ORIGINAL} original + {N_HARD} hard)\")\n",
    "\n",
    "\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# STATE ENCODER (31 base features — unchanged)\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "class StateEncoder:\n",
    "    @staticmethod\n",
    "    def encode(player_history, opponent_history, round_num):\n",
    "        last_2_self  = ([0]*2+player_history[-2:])[-2:]   if player_history   else [0,0]\n",
    "        last_2_opp   = ([0]*2+opponent_history[-2:])[-2:] if opponent_history else [0,0]\n",
    "        last_5_self  = ([0]*5+player_history[-5:])[-5:]   if player_history   else [0]*5\n",
    "        last_5_opp   = ([0]*5+opponent_history[-5:])[-5:] if opponent_history else [0]*5\n",
    "        n=max(1,round_num)\n",
    "        coop_self        = sum(1-a for a in player_history)/n\n",
    "        coop_opp         = sum(1-a for a in opponent_history)/n\n",
    "        recent_self      = player_history[-10:] if player_history else []\n",
    "        recent_opp       = opponent_history[-10:] if opponent_history else []\n",
    "        coop_self_recent = sum(1-a for a in recent_self)/max(1,len(recent_self))\n",
    "        coop_opp_recent  = sum(1-a for a in recent_opp)/max(1,len(recent_opp))\n",
    "        mutual_coop      = sum(1 for a,o in zip(player_history,opponent_history) if a==C and o==C)/n\n",
    "        streak=0\n",
    "        for a in reversed(opponent_history):\n",
    "            if a==D: streak+=1\n",
    "            else: break\n",
    "        streak_feat=min(streak,10)/10.0\n",
    "        progress=round_num/ROUNDS_PER_EPISODE\n",
    "        def coop_after(actions, shift=1):\n",
    "            resp=[1-opponent_history[t+shift] for t,a in enumerate(actions)\n",
    "                  if a==D and t+shift<len(opponent_history)]\n",
    "            return np.mean(resp) if resp else 0.5\n",
    "        coop_after_self_def  = coop_after(player_history)\n",
    "        coop_after_self_coop = coop_after([a for a in player_history if a==C])\n",
    "        ever_forgave=float(any(opponent_history[t+1]==C for t,a in enumerate(player_history)\n",
    "                               if a==D and t+1<len(opponent_history)))\n",
    "        hard_tft_signal=0.0\n",
    "        if len(opponent_history)>=3 and len(player_history)>=3:\n",
    "            hard_tft_signal=float(player_history[-2]==D and player_history[-3]==D\n",
    "                                   and opponent_history[-1]==D)\n",
    "        first_defect=float(len(opponent_history)>0 and opponent_history[0]==D)\n",
    "        prober_pattern=0.0\n",
    "        if len(opponent_history)>=3:\n",
    "            prober_pattern=float(opponent_history[0]==D and opponent_history[1]==C\n",
    "                                  and opponent_history[2]==C)\n",
    "        early_def_rate=sum(opponent_history[:5])/max(1,min(5,len(opponent_history)))\n",
    "        is_prober_likely=0.0\n",
    "        if round_num>=4:\n",
    "            late_opp=opponent_history[3:]\n",
    "            is_prober_likely=float(sum(late_opp)/max(1,len(late_opp))>0.7 and prober_pattern>0.5)\n",
    "        defection_after_coop=1.0-coop_after_self_coop\n",
    "        features=(last_2_self+last_2_opp+last_5_self+last_5_opp+\n",
    "            [coop_self,coop_opp,coop_self_recent,coop_opp_recent,\n",
    "             mutual_coop,streak_feat,progress,progress**2,\n",
    "             coop_after_self_def,coop_after_self_coop,\n",
    "             ever_forgave,hard_tft_signal,\n",
    "             first_defect,prober_pattern,early_def_rate,is_prober_likely,\n",
    "             defection_after_coop])\n",
    "        return np.array(features, dtype=np.float32)\n",
    "\n",
    "STATE_BASE_DIM   = 31\n",
    "SLOW_HIDDEN_DIM  = 96\n",
    "FAST_HIDDEN_DIM  = 32\n",
    "COMBINED_DIM     = SLOW_HIDDEN_DIM + FAST_HIDDEN_DIM\n",
    "STATE_DIM_DRQN   = STATE_BASE_DIM + COMBINED_DIM\n",
    "STATE_DIM_BARE   = STATE_BASE_DIM\n",
    "\n",
    "print(f\"[INFO] State dim — DRQN v9r: {STATE_DIM_DRQN} | Bare DQN: {STATE_DIM_BARE}\")\n",
    "\n",
    "\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# ENVIRONMENT\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "class IPDEnvironment:\n",
    "    def __init__(self, opponent_class, true_idx: int = -1):\n",
    "        self.opponent_class=opponent_class; self.true_idx=true_idx; self.reset()\n",
    "\n",
    "    def reset(self):\n",
    "        self.opponent=self.opponent_class()\n",
    "        if hasattr(self.opponent,'reset'): self.opponent.reset()\n",
    "        self.player_history=[]; self.opponent_history=[]; self.round=0\n",
    "        return self._get_obs()\n",
    "\n",
    "    def step(self, player_action):\n",
    "        opp_action=self.opponent.move(self.opponent_history[:], self.player_history[:])\n",
    "        reward,_=PAYOFF[(player_action,opp_action)]\n",
    "        self.player_history.append(player_action)\n",
    "        self.opponent_history.append(opp_action)\n",
    "        self.round+=1\n",
    "        done=self.round>=ROUNDS_PER_EPISODE\n",
    "        return self._get_obs(), reward, done, {'opponent_action': opp_action}\n",
    "\n",
    "    def _get_obs(self):\n",
    "        return StateEncoder.encode(self.player_history,self.opponent_history,self.round)\n",
    "\n",
    "\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# EPISODE TRANSFORMER (unchanged from v8)\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "class SinusoidalPE(nn.Module):\n",
    "    def __init__(self, d_model: int, max_len: int = 200):\n",
    "        super().__init__()\n",
    "        pe  = torch.zeros(max_len, d_model)\n",
    "        pos = torch.arange(0, max_len, dtype=torch.float).unsqueeze(1)\n",
    "        div = torch.exp(torch.arange(0, d_model, 2).float() * (-np.log(10000.0) / d_model))\n",
    "        pe[:, 0::2] = torch.sin(pos * div)\n",
    "        pe[:, 1::2] = torch.cos(pos * div)\n",
    "        self.register_buffer('pe', pe.unsqueeze(0))\n",
    "\n",
    "    def forward(self, x):\n",
    "        return x + self.pe[:, :x.size(1), :]\n",
    "\n",
    "\n",
    "class EpisodeTransformer(nn.Module):\n",
    "    def __init__(self, d_model: int = SLOW_HIDDEN_DIM, nhead: int = 4,\n",
    "                 num_layers: int = 3, dim_ff: int = 256,\n",
    "                 max_len: int = TRANSFORMER_WINDOW + 2):\n",
    "        super().__init__()\n",
    "        self.input_proj = nn.Linear(2, d_model)\n",
    "        self.pe         = SinusoidalPE(d_model, max_len)\n",
    "        encoder_layer   = nn.TransformerEncoderLayer(\n",
    "            d_model=d_model, nhead=nhead,\n",
    "            dim_feedforward=dim_ff, dropout=0.0,\n",
    "            batch_first=True, norm_first=True\n",
    "        )\n",
    "        self.transformer = nn.TransformerEncoder(encoder_layer, num_layers=num_layers)\n",
    "        self.out_norm    = nn.LayerNorm(d_model)\n",
    "        self.action_proj = nn.Embedding(ACTION_DIM, d_model)\n",
    "        self.action_norm = nn.LayerNorm(d_model)\n",
    "\n",
    "    def forward(self, seq: torch.Tensor) -> torch.Tensor:\n",
    "        x = self.input_proj(seq)\n",
    "        x = self.pe(x)\n",
    "        x = self.transformer(x)\n",
    "        z = self.out_norm(x[:, -1, :])\n",
    "        return z\n",
    "\n",
    "    def encode_with_action(self, z: torch.Tensor, actions: torch.Tensor) -> torch.Tensor:\n",
    "        proj  = self.action_proj(actions)\n",
    "        z_act = self.action_norm(z + proj)\n",
    "        return F.normalize(z_act, dim=-1)\n",
    "\n",
    "    def encode_seq(self, seq: torch.Tensor) -> torch.Tensor:\n",
    "        return self.forward(seq)\n",
    "\n",
    "\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# FAST STREAM (unchanged from v8)\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "class FastStream(nn.Module):\n",
    "    def __init__(self, fast_window: int = FAST_WINDOW,\n",
    "                 out_dim: int = FAST_HIDDEN_DIM):\n",
    "        super().__init__()\n",
    "        self.net = nn.Sequential(\n",
    "            nn.Flatten(start_dim=1),\n",
    "            nn.Linear(fast_window * 2, 64), nn.ReLU(),\n",
    "            nn.Linear(64, out_dim),          nn.LayerNorm(out_dim), nn.ReLU(),\n",
    "        )\n",
    "\n",
    "    def forward(self, fast_seq: torch.Tensor) -> torch.Tensor:\n",
    "        return self.net(fast_seq)\n",
    "\n",
    "\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# BAYESIAN OPPONENT HEAD (unchanged from v8)\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "class BayesianOpponentHead(nn.Module):\n",
    "    def __init__(self, z_dim: int = SLOW_HIDDEN_DIM, n_opp: int = N_OPPONENTS):\n",
    "        super().__init__()\n",
    "        self.n_opp = n_opp\n",
    "        self.emission = nn.Sequential(\n",
    "            nn.Linear(z_dim, 128), nn.ReLU(),\n",
    "            nn.Linear(128, n_opp),\n",
    "        )\n",
    "        self.class_coop_bias = nn.Parameter(torch.zeros(n_opp))\n",
    "\n",
    "    def forward(self, z: torch.Tensor) -> torch.Tensor:\n",
    "        return self.emission(z)\n",
    "\n",
    "    def expected_reward(self, posterior: torch.Tensor,\n",
    "                        payoff_t: torch.Tensor) -> torch.Tensor:\n",
    "        \"\"\"\n",
    "        Returns exp_r (B, 2) — expected reward for each of my actions.\n",
    "        CHANGE 1 caller: subtract mean before using as shaping signal.\n",
    "        \"\"\"\n",
    "        p_coop = torch.sigmoid(self.class_coop_bias)\n",
    "        r_if_coop = payoff_t[:, 0]\n",
    "        r_if_def  = payoff_t[:, 1]\n",
    "        per_class_exp_r = p_coop.unsqueeze(1) * r_if_coop.unsqueeze(0) + \\\n",
    "                          (1 - p_coop).unsqueeze(1) * r_if_def.unsqueeze(0)\n",
    "        return posterior @ per_class_exp_r\n",
    "\n",
    "\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# FULL NETWORK (unchanged from v8)\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "class TransformerDQN(nn.Module):\n",
    "    def __init__(self, base_dim: int = STATE_BASE_DIM,\n",
    "                 slow_dim: int = SLOW_HIDDEN_DIM,\n",
    "                 fast_dim: int = FAST_HIDDEN_DIM,\n",
    "                 action_dim: int = ACTION_DIM,\n",
    "                 hidden: int = 256):\n",
    "        super().__init__()\n",
    "        self.slow_encoder  = EpisodeTransformer(d_model=slow_dim)\n",
    "        self.fast_encoder  = FastStream(FAST_WINDOW, fast_dim)\n",
    "        self.bayes_head    = BayesianOpponentHead(slow_dim, N_OPPONENTS)\n",
    "\n",
    "        combined = base_dim + slow_dim + fast_dim\n",
    "        self.shared = nn.Sequential(\n",
    "            nn.Linear(combined, hidden),      nn.LayerNorm(hidden),   nn.ReLU(),\n",
    "            nn.Linear(hidden, hidden),        nn.LayerNorm(hidden),   nn.ReLU(),\n",
    "            nn.Linear(hidden, hidden // 2),   nn.LayerNorm(hidden//2), nn.ReLU(),\n",
    "        )\n",
    "        self.value_head     = nn.Linear(hidden // 2, 1)\n",
    "        self.advantage_head = nn.Linear(hidden // 2, action_dim)\n",
    "\n",
    "    def forward(self, base_obs: torch.Tensor,\n",
    "                slow_seq: torch.Tensor,\n",
    "                fast_seq: torch.Tensor) -> Tuple[torch.Tensor, torch.Tensor, torch.Tensor]:\n",
    "        slow_z      = self.slow_encoder(slow_seq)\n",
    "        fast_z      = self.fast_encoder(fast_seq)\n",
    "        class_logits = self.bayes_head(slow_z)\n",
    "\n",
    "        x      = torch.cat([base_obs, slow_z, fast_z], dim=-1)\n",
    "        shared = self.shared(x)\n",
    "        V      = self.value_head(shared)\n",
    "        A      = self.advantage_head(shared)\n",
    "        q      = V + A - A.mean(dim=-1, keepdim=True)\n",
    "        return q, slow_z, class_logits\n",
    "\n",
    "    def encode_seq(self, slow_seq: torch.Tensor) -> torch.Tensor:\n",
    "        return self.slow_encoder.encode_seq(slow_seq)\n",
    "\n",
    "    def encode_with_action(self, z: torch.Tensor, actions: torch.Tensor) -> torch.Tensor:\n",
    "        return self.slow_encoder.encode_with_action(z, actions)\n",
    "\n",
    "\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# REPLAY BUFFERS (unchanged)\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "class GRUSequenceBuffer:\n",
    "    def __init__(self, capacity: int = 10_000):\n",
    "        self.capacity=capacity\n",
    "        self._seqs=np.zeros((capacity, TRANSFORMER_WINDOW, 2), dtype=np.float32)\n",
    "        self._opp=np.full(capacity, -1, dtype=np.int32)\n",
    "        self._pos=0; self._size=0\n",
    "\n",
    "    def push(self, seq: np.ndarray, opp_idx: int):\n",
    "        self._seqs[self._pos]=seq; self._opp[self._pos]=opp_idx\n",
    "        self._pos=(self._pos+1)%self.capacity\n",
    "        self._size=min(self._size+1, self.capacity)\n",
    "\n",
    "    def sample_negatives_batch(self, anchor_opp_indices: np.ndarray, n: int):\n",
    "        if self._size<n+1: return None\n",
    "        valid=self._opp[:self._size]; B=len(anchor_opp_indices)\n",
    "        result=np.zeros((B,n,TRANSFORMER_WINDOW,2), dtype=np.float32)\n",
    "        for i,oi in enumerate(anchor_opp_indices):\n",
    "            mask=(valid!=oi); cands=np.where(mask)[0]\n",
    "            if len(cands)<n: return None\n",
    "            chosen=np.random.choice(cands, size=n, replace=False)\n",
    "            result[i]=self._seqs[chosen]\n",
    "        return result\n",
    "\n",
    "    def __len__(self): return self._size\n",
    "\n",
    "\n",
    "SeqTransitionV9 = namedtuple('SeqTransitionV9',\n",
    "    ('slow_seq','fast_seq','base_obs','action','reward',\n",
    "     'next_slow','next_fast','next_base_obs','done'))\n",
    "\n",
    "class SequenceReplayBuffer:\n",
    "    def __init__(self, capacity: int = 60_000):\n",
    "        self.buffer: deque = deque(maxlen=capacity)\n",
    "        self.opp_indices: deque = deque(maxlen=capacity)\n",
    "\n",
    "    def push(self, slow_seq, fast_seq, base_obs, action, reward,\n",
    "             next_slow, next_fast, next_base_obs, done, opp_idx):\n",
    "        self.buffer.append(SeqTransitionV9(\n",
    "            slow_seq, fast_seq, base_obs, action, reward,\n",
    "            next_slow, next_fast, next_base_obs, float(done)\n",
    "        ))\n",
    "        self.opp_indices.append(opp_idx)\n",
    "\n",
    "    def sample(self, batch_size: int):\n",
    "        indices = random.sample(range(len(self.buffer)), batch_size)\n",
    "        batch   = [self.buffer[i]         for i in indices]\n",
    "        opp_ids = np.array([self.opp_indices[i] for i in indices], dtype=np.int32)\n",
    "        return SeqTransitionV9(*zip(*batch)), opp_ids\n",
    "\n",
    "    def __len__(self): return len(self.buffer)\n",
    "\n",
    "\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# INFONCE CONTRASTIVE LOSS (unchanged)\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "def info_nce_loss(anchor, positive, negatives, temperature=0.1):\n",
    "    pos_sim = (anchor * positive).sum(dim=-1, keepdim=True) / temperature\n",
    "    neg_sim = torch.bmm(negatives, anchor.unsqueeze(-1)).squeeze(-1) / temperature\n",
    "    logits  = torch.cat([pos_sim, neg_sim], dim=-1)\n",
    "    labels  = torch.zeros(anchor.shape[0], dtype=torch.long, device=anchor.device)\n",
    "    return F.cross_entropy(logits, labels)\n",
    "\n",
    "\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# DRQN v9 CONFIG\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "@dataclass\n",
    "class DRQNConfig:\n",
    "    hidden_size:        int   = 256\n",
    "    slow_dim:           int   = SLOW_HIDDEN_DIM\n",
    "    fast_dim:           int   = FAST_HIDDEN_DIM\n",
    "    lr:                 float = 1e-4\n",
    "    gamma:              float = 0.98\n",
    "    batch_size:         int   = 256\n",
    "    target_update_freq: int   = 8\n",
    "    eps_start:          float = 1.0\n",
    "    eps_end:            float = 0.02\n",
    "    eps_decay:          float = 500\n",
    "    bayes_lambda:       float = 0.15\n",
    "    contrast_lambda:    float = 0.20\n",
    "    contrast_tau:       float = 0.03\n",
    "    n_negatives:        int   = 12\n",
    "    k_uncertainty:      float = 0.05\n",
    "    k_error:            float = 0.04\n",
    "    error_ema_alpha:    float = 0.1\n",
    "    # CHANGE 1: calibrated raw shaping (0.25, between v8's 0.3 and safer 0.2)\n",
    "    shape_lambda:       float = SHAPE_LAMBDA       # 0.25\n",
    "    # CHANGE 2: confidence gate power (2.0 = quadratic, delayed commitment)\n",
    "    confidence_power:   float = CONFIDENCE_POWER   # 2.0\n",
    "    # CHANGE 3: v8 meta params restored (freq=15, steps=3, lr=3e-4)\n",
    "    meta_adapt_freq:    int   = META_ADAPT_FREQ\n",
    "    meta_window:        int   = META_WINDOW\n",
    "    meta_steps:         int   = META_STEPS\n",
    "    meta_lr:            float = META_LR\n",
    "    seed:               int   = SEED\n",
    "\n",
    "\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# CHANGE 3 — TARGETED META ADAPTER (fast stream + Q-head only)\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "class MetaAdapter:\n",
    "    \"\"\"\n",
    "    CHANGE 3 (structural part retained from v9, params restored to v8):\n",
    "\n",
    "    Targeted MAML-style adaptation — only fast_encoder + shared + Q-heads.\n",
    "    slow_encoder (EpisodeTransformer) is FROZEN during the inner loop.\n",
    "\n",
    "    Why freeze slow encoder:\n",
    "      - slow stream = opponent identity (stable for the whole episode)\n",
    "      - fast stream = recent behaviour (legitimately changes mid-episode)\n",
    "      Updating the transformer mid-episode would corrupt the Bayesian posterior\n",
    "      built by the slow stream, undoing opponent identification.\n",
    "\n",
    "    Params restored to v8 values (freq=15, steps=3, lr=3e-4):\n",
    "      v9 used freq=10, steps=5, lr=1e-3 which caused over-fitting to the\n",
    "      last ~10 transitions and collapsed cooperation against grudgers.\n",
    "\n",
    "    Inner loop uses raw exp_r shaping (CHANGE 1) not zero-sum advantage.\n",
    "    \"\"\"\n",
    "    def __init__(self, policy_net: TransformerDQN,\n",
    "                 meta_lr: float, meta_steps: int,\n",
    "                 payoff_t: torch.Tensor, gamma: float = 0.98):\n",
    "        self.policy_net  = policy_net\n",
    "        self.meta_lr     = meta_lr\n",
    "        self.meta_steps  = meta_steps\n",
    "        self.payoff_t    = payoff_t\n",
    "        self.gamma       = gamma\n",
    "        self.fast_net    = None\n",
    "        self._recent: deque = deque(maxlen=META_WINDOW)\n",
    "\n",
    "        # Parameters to adapt (fast stream + Q head) — slow encoder is frozen\n",
    "        self._adapt_param_names = set()\n",
    "        for name, _ in policy_net.named_parameters():\n",
    "            if name.startswith('slow_encoder'):\n",
    "                continue   # frozen\n",
    "            self._adapt_param_names.add(name)\n",
    "\n",
    "    def record(self, slow_seq, fast_seq, base_obs, action, reward,\n",
    "               next_slow, next_fast, next_base_obs, done):\n",
    "        self._recent.append((slow_seq, fast_seq, base_obs, action, reward,\n",
    "                              next_slow, next_fast, next_base_obs, done))\n",
    "\n",
    "    def adapt(self):\n",
    "        if len(self._recent) < 4:\n",
    "            self.fast_net = None\n",
    "            return\n",
    "\n",
    "        fast_net = copy.deepcopy(self.policy_net)\n",
    "        fast_net.train()\n",
    "\n",
    "        # CHANGE 3: Only optimise non-slow-encoder parameters\n",
    "        adapt_params = [p for name, p in fast_net.named_parameters()\n",
    "                        if name in self._adapt_param_names]\n",
    "        opt = optim.SGD(adapt_params, lr=self.meta_lr, momentum=0.9)\n",
    "\n",
    "        batch = list(self._recent)\n",
    "        slow_seqs  = torch.tensor(np.array([t[0] for t in batch]), dtype=torch.float32).to(device)\n",
    "        fast_seqs  = torch.tensor(np.array([t[1] for t in batch]), dtype=torch.float32).to(device)\n",
    "        base_obss  = torch.tensor(np.array([t[2] for t in batch]), dtype=torch.float32).to(device)\n",
    "        actions    = torch.tensor([t[3] for t in batch],           dtype=torch.long).to(device)\n",
    "        rewards    = torch.tensor([t[4] for t in batch],           dtype=torch.float32).to(device)\n",
    "        nslows     = torch.tensor(np.array([t[5] for t in batch]), dtype=torch.float32).to(device)\n",
    "        nfasts     = torch.tensor(np.array([t[6] for t in batch]), dtype=torch.float32).to(device)\n",
    "        nbase_obss = torch.tensor(np.array([t[7] for t in batch]), dtype=torch.float32).to(device)\n",
    "        dones      = torch.tensor([float(t[8]) for t in batch],    dtype=torch.float32).to(device)\n",
    "\n",
    "        for _ in range(self.meta_steps):\n",
    "            q_all, slow_z, class_logits = fast_net(base_obss, slow_seqs, fast_seqs)\n",
    "            posterior  = torch.softmax(class_logits, dim=-1)\n",
    "            exp_r      = fast_net.bayes_head.expected_reward(posterior, self.payoff_t)\n",
    "\n",
    "            # CHANGE 1: raw exp_r shaping (not zero-sum) — preserves cooperative bias\n",
    "            q_shaped   = q_all + SHAPE_LAMBDA * exp_r.detach()\n",
    "            q_vals     = q_shaped.gather(1, actions.unsqueeze(1)).squeeze(1)\n",
    "\n",
    "            with torch.no_grad():\n",
    "                nq, _, nlogits = fast_net(nbase_obss, nslows, nfasts)\n",
    "                n_post   = torch.softmax(nlogits, dim=-1)\n",
    "                n_exp_r  = fast_net.bayes_head.expected_reward(n_post, self.payoff_t)\n",
    "                nq_shaped = nq + SHAPE_LAMBDA * n_exp_r\n",
    "                next_acts = nq_shaped.argmax(1)\n",
    "                nq_tgt, _, _ = fast_net(nbase_obss, nslows, nfasts)\n",
    "                next_q  = nq_tgt.gather(1, next_acts.unsqueeze(1)).squeeze(1)\n",
    "                targets  = rewards + self.gamma * next_q * (1 - dones)\n",
    "\n",
    "            loss = F.smooth_l1_loss(q_vals, targets)\n",
    "            opt.zero_grad(); loss.backward()\n",
    "            torch.nn.utils.clip_grad_norm_(adapt_params, 1.0)\n",
    "            opt.step()\n",
    "\n",
    "        fast_net.eval()\n",
    "        self.fast_net = fast_net\n",
    "\n",
    "    def get_net(self) -> TransformerDQN:\n",
    "        return self.fast_net if self.fast_net is not None else self.policy_net\n",
    "\n",
    "    def reset(self):\n",
    "        self._recent.clear()\n",
    "        self.fast_net = None\n",
    "\n",
    "\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# DRQN v9 AGENT\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "class DRQNAgent:\n",
    "    name = \"DRQN+v9r\"\n",
    "\n",
    "    def __init__(self, config: DRQNConfig = None):\n",
    "        self.config = config or DRQNConfig()\n",
    "        self._rng   = random.Random(self.config.seed)\n",
    "        self.episode_num = 0\n",
    "        self.steps   = 0\n",
    "\n",
    "        self.policy_net = TransformerDQN(\n",
    "            STATE_BASE_DIM, SLOW_HIDDEN_DIM, FAST_HIDDEN_DIM,\n",
    "            ACTION_DIM, self.config.hidden_size\n",
    "        ).to(device)\n",
    "        self.target_net = TransformerDQN(\n",
    "            STATE_BASE_DIM, SLOW_HIDDEN_DIM, FAST_HIDDEN_DIM,\n",
    "            ACTION_DIM, self.config.hidden_size\n",
    "        ).to(device)\n",
    "        self.target_net.load_state_dict(self.policy_net.state_dict())\n",
    "        self.target_net.eval()\n",
    "\n",
    "        self.optimizer = optim.Adam(self.policy_net.parameters(),\n",
    "                                    lr=self.config.lr, weight_decay=1e-5)\n",
    "\n",
    "        self.seq_buffer  = SequenceReplayBuffer()\n",
    "        self.gru_seq_buf = GRUSequenceBuffer()\n",
    "\n",
    "        self._interaction_history: List[Tuple[int,int]] = []\n",
    "        self._error_ema:     float = 0.5\n",
    "        self._current_opp_idx: int = 0\n",
    "        self._last_aux_entropy: float = np.log(N_OPPONENTS)\n",
    "        self._last_aux_pred:    int   = 0\n",
    "        self._ep_seqs: List[np.ndarray] = []\n",
    "\n",
    "        self._payoff_t  = PAYOFF_TENSOR.to(device)\n",
    "        self.meta       = MetaAdapter(self.policy_net, self.config.meta_lr,\n",
    "                                      self.config.meta_steps, self._payoff_t,\n",
    "                                      self.config.gamma)\n",
    "        self._round_in_ep = 0\n",
    "        self._log_posterior: Optional[torch.Tensor] = None\n",
    "\n",
    "    def _build_slow_seq(self, history):\n",
    "        W    = TRANSFORMER_WINDOW\n",
    "        hist = history[-W:]\n",
    "        pad  = [(0, 0)] * (W - len(hist))\n",
    "        return np.array(pad + list(hist), dtype=np.float32)\n",
    "\n",
    "    def _build_fast_seq(self, history):\n",
    "        W    = FAST_WINDOW\n",
    "        hist = history[-W:]\n",
    "        pad  = [(0, 0)] * (W - len(hist))\n",
    "        return np.array(pad + list(hist), dtype=np.float32)\n",
    "\n",
    "    def _compute_shaping(self, q_vals: torch.Tensor,\n",
    "                          exp_r: torch.Tensor,\n",
    "                          posterior: torch.Tensor) -> torch.Tensor:\n",
    "        \"\"\"\n",
    "        CHANGE 1 + CHANGE 2: Soft confidence-gated raw shaping.\n",
    "\n",
    "        q_shaped = q + λ * gate * exp_r\n",
    "\n",
    "        gate = confidence^power,  confidence = 1 - H(posterior)/log(N_OPP)\n",
    "\n",
    "        Key differences from v9:\n",
    "          - exp_r is NOT centred. Raw exp_r preserves the cooperative bias:\n",
    "            against a cooperator both C and D get positive shaping, but C more.\n",
    "            Against a defector D gets stronger lift. Gentler than zero-sum,\n",
    "            which created a hard defection push before the posterior settled.\n",
    "          - gate uses power=CONFIDENCE_POWER (default 2.0, quadratic), staying\n",
    "            near 0 for the first ~15-20 rounds while the posterior accumulates.\n",
    "            This prevents the early defection reflex that killed grudger perf.\n",
    "          - λ=0.25 (v8 was 0.3, v9 was 0.5) — conservative and reliable.\n",
    "        \"\"\"\n",
    "        # CHANGE 2: soft confidence gate with power calibration\n",
    "        H     = -(posterior * (posterior + 1e-8).log()).sum(dim=-1)   # (B,)\n",
    "        H_max = np.log(N_OPPONENTS)\n",
    "        # Quadratic gate: near 0 early (high H), ramps as posterior sharpens\n",
    "        gate  = ((1.0 - H / H_max).clamp(0.0, 1.0) ** self.config.confidence_power\n",
    "                 ).unsqueeze(-1)                                        # (B, 1)\n",
    "\n",
    "        # CHANGE 1: raw exp_r (cooperative-biased), not zero-sum\n",
    "        return q_vals + self.config.shape_lambda * gate * exp_r\n",
    "\n",
    "    def select_action(self, base_obs, eval_mode=False):\n",
    "        eps = self._compute_epsilon()\n",
    "        if not eval_mode and self._rng.random() < eps:\n",
    "            return self._rng.randint(0, ACTION_DIM-1)\n",
    "\n",
    "        slow_seq  = self._build_slow_seq(self._interaction_history)\n",
    "        fast_seq  = self._build_fast_seq(self._interaction_history)\n",
    "        slow_t    = torch.tensor(slow_seq,  dtype=torch.float32).unsqueeze(0).to(device)\n",
    "        fast_t    = torch.tensor(fast_seq,  dtype=torch.float32).unsqueeze(0).to(device)\n",
    "        obs_t     = torch.tensor(base_obs,  dtype=torch.float32).unsqueeze(0).to(device)\n",
    "\n",
    "        net = self.meta.get_net() if eval_mode else self.policy_net\n",
    "\n",
    "        with torch.no_grad():\n",
    "            q_vals, slow_z, class_logits = net(obs_t, slow_t, fast_t)\n",
    "\n",
    "            if self._log_posterior is None:\n",
    "                self._log_posterior = torch.zeros(1, N_OPPONENTS, device=device)\n",
    "            self._log_posterior = self._log_posterior + F.log_softmax(class_logits, dim=-1)\n",
    "            self._log_posterior = self._log_posterior - self._log_posterior.logsumexp(dim=-1, keepdim=True)\n",
    "\n",
    "            posterior = torch.exp(self._log_posterior)\n",
    "            exp_r     = net.bayes_head.expected_reward(posterior, self._payoff_t)\n",
    "\n",
    "            # CHANGE 1+2: confidence-weighted advantage shaping\n",
    "            q_shaped  = self._compute_shaping(q_vals, exp_r, posterior)\n",
    "\n",
    "            self._last_aux_entropy = float(-(posterior * (posterior + 1e-8).log()).sum())\n",
    "            self._last_aux_pred    = int(posterior.argmax(dim=-1).item())\n",
    "\n",
    "        return int(q_shaped.argmax(dim=-1).item())\n",
    "\n",
    "    def _compute_epsilon(self):\n",
    "        base       = self.config.eps_end + (self.config.eps_start - self.config.eps_end) * \\\n",
    "                     np.exp(-self.episode_num / self.config.eps_decay)\n",
    "        unc_bonus  = self.config.k_uncertainty * min(self._last_aux_entropy / np.log(N_OPPONENTS), 1.0)\n",
    "        err_bonus  = self.config.k_error * self._error_ema\n",
    "        total_bonus = min(unc_bonus + err_bonus, base * 0.5)\n",
    "        return min(1.0, base + total_bonus)\n",
    "\n",
    "    @property\n",
    "    def epsilon(self): return self._compute_epsilon()\n",
    "\n",
    "    def push(self, base_obs, action, reward, next_base_obs, done):\n",
    "        slow_seq  = self._build_slow_seq(self._interaction_history[:-1])\n",
    "        fast_seq  = self._build_fast_seq(self._interaction_history[:-1])\n",
    "        next_slow = self._build_slow_seq(self._interaction_history)\n",
    "        next_fast = self._build_fast_seq(self._interaction_history)\n",
    "        self.seq_buffer.push(slow_seq, fast_seq, base_obs, action, reward,\n",
    "                             next_slow, next_fast, next_base_obs, done,\n",
    "                             self._current_opp_idx)\n",
    "        self._ep_seqs.append(slow_seq.copy())\n",
    "        self.meta.record(slow_seq, fast_seq, base_obs, action, reward,\n",
    "                         next_slow, next_fast, next_base_obs, done)\n",
    "\n",
    "    def train_step(self):\n",
    "        if len(self.seq_buffer) < self.config.batch_size:\n",
    "            return {}\n",
    "\n",
    "        batch, opp_ids = self.seq_buffer.sample(self.config.batch_size)\n",
    "        B = self.config.batch_size\n",
    "\n",
    "        SLOW = torch.tensor(np.array(batch.slow_seq),      dtype=torch.float32).to(device)\n",
    "        FAST = torch.tensor(np.array(batch.fast_seq),      dtype=torch.float32).to(device)\n",
    "        OBS  = torch.tensor(np.array(batch.base_obs),      dtype=torch.float32).to(device)\n",
    "        A    = torch.tensor(batch.action,                   dtype=torch.long).to(device)\n",
    "        R    = torch.tensor(batch.reward,                   dtype=torch.float32).to(device)\n",
    "        NSLOW= torch.tensor(np.array(batch.next_slow),     dtype=torch.float32).to(device)\n",
    "        NFAST= torch.tensor(np.array(batch.next_fast),     dtype=torch.float32).to(device)\n",
    "        NOBS = torch.tensor(np.array(batch.next_base_obs), dtype=torch.float32).to(device)\n",
    "        DN   = torch.tensor(batch.done,                    dtype=torch.float32).to(device)\n",
    "\n",
    "        q_all, slow_z, class_logits = self.policy_net(OBS, SLOW, FAST)\n",
    "\n",
    "        posterior  = torch.softmax(class_logits, dim=-1)\n",
    "        exp_r      = self.policy_net.bayes_head.expected_reward(posterior, self._payoff_t)\n",
    "\n",
    "        # CHANGE 1+2: confidence-weighted advantage shaping (training)\n",
    "        q_shaped   = self._compute_shaping(q_all, exp_r.detach(), posterior.detach())\n",
    "        q_vals     = q_shaped.gather(1, A.unsqueeze(1)).squeeze(1)\n",
    "\n",
    "        with torch.no_grad():\n",
    "            nq_pol, _, nlogits = self.policy_net(NOBS, NSLOW, NFAST)\n",
    "            n_post    = torch.softmax(nlogits, dim=-1)\n",
    "            n_exp_r   = self.policy_net.bayes_head.expected_reward(n_post, self._payoff_t)\n",
    "            nq_shaped = self._compute_shaping(nq_pol, n_exp_r, n_post)\n",
    "            next_acts = nq_shaped.argmax(1)\n",
    "\n",
    "            nq_tgt, _, _ = self.target_net(NOBS, NSLOW, NFAST)\n",
    "            next_q  = nq_tgt.gather(1, next_acts.unsqueeze(1)).squeeze(1)\n",
    "            targets  = R + self.config.gamma * next_q * (1 - DN)\n",
    "\n",
    "        td_loss = F.smooth_l1_loss(q_vals, targets)\n",
    "\n",
    "        opp_ids_t  = torch.tensor(opp_ids, dtype=torch.long, device=device)\n",
    "        bayes_loss = F.cross_entropy(class_logits, opp_ids_t)\n",
    "\n",
    "        contrast_loss = torch.tensor(0.0, device=device)\n",
    "        neg_seqs_np   = self.gru_seq_buf.sample_negatives_batch(opp_ids, self.config.n_negatives)\n",
    "\n",
    "        if neg_seqs_np is not None:\n",
    "            opp_ids_t2    = torch.tensor(opp_ids, dtype=torch.long, device=device)\n",
    "            same_opp_mask = (opp_ids_t2.unsqueeze(0) == opp_ids_t2.unsqueeze(1))\n",
    "            same_opp_mask.fill_diagonal_(False)\n",
    "            pos_idx = torch.arange(B, device=device)\n",
    "            for i in range(B):\n",
    "                candidates = same_opp_mask[i].nonzero(as_tuple=True)[0]\n",
    "                if len(candidates) > 0:\n",
    "                    pos_idx[i] = candidates[torch.randint(len(candidates),(1,),device=device)]\n",
    "                else:\n",
    "                    pos_idx[i] = (i + 1) % B\n",
    "\n",
    "            pos_seq   = SLOW[pos_idx]\n",
    "            z_anchor  = self.policy_net.encode_seq(SLOW)\n",
    "            z_pos     = self.policy_net.encode_seq(pos_seq)\n",
    "            z_anc_act = self.policy_net.encode_with_action(z_anchor, A)\n",
    "            z_pos_act = self.policy_net.encode_with_action(z_pos, A[pos_idx])\n",
    "\n",
    "            K     = self.config.n_negatives\n",
    "            neg_t = torch.tensor(neg_seqs_np, dtype=torch.float32).to(device)\n",
    "            neg_t = neg_t.view(B * K, TRANSFORMER_WINDOW, 2)\n",
    "            z_neg = self.policy_net.encode_seq(neg_t)\n",
    "            A_rep = A.repeat_interleave(K)\n",
    "            z_neg_act = self.policy_net.encode_with_action(z_neg, A_rep)\n",
    "            z_neg_act = z_neg_act.view(B, K, -1)\n",
    "\n",
    "            contrast_loss = info_nce_loss(\n",
    "                z_anc_act, z_pos_act, z_neg_act,\n",
    "                temperature=self.config.contrast_tau\n",
    "            )\n",
    "\n",
    "        total_loss = (td_loss\n",
    "                      + self.config.bayes_lambda   * bayes_loss\n",
    "                      + self.config.contrast_lambda * contrast_loss)\n",
    "\n",
    "        self.optimizer.zero_grad()\n",
    "        total_loss.backward()\n",
    "        torch.nn.utils.clip_grad_norm_(self.policy_net.parameters(), 1.0)\n",
    "        self.optimizer.step()\n",
    "\n",
    "        self.steps += 1\n",
    "        if self.steps % self.config.target_update_freq == 0:\n",
    "            self.target_net.load_state_dict(self.policy_net.state_dict())\n",
    "\n",
    "        return {\n",
    "            'loss':          td_loss.item(),\n",
    "            'bayes_loss':    bayes_loss.item(),\n",
    "            'contrast_loss': float(contrast_loss) if isinstance(contrast_loss, torch.Tensor) else 0.0,\n",
    "        }\n",
    "\n",
    "    def on_episode_start(self):\n",
    "        self.episode_num += 1\n",
    "        self._interaction_history = []\n",
    "        self._last_aux_entropy    = np.log(N_OPPONENTS)\n",
    "        self._last_aux_pred       = 0\n",
    "        self._ep_seqs             = []\n",
    "        self._round_in_ep         = 0\n",
    "        self._log_posterior       = None\n",
    "        self.meta.reset()\n",
    "\n",
    "    def on_episode_end(self):\n",
    "        if self._ep_seqs:\n",
    "            for i in range(0, len(self._ep_seqs), 2):\n",
    "                self.gru_seq_buf.push(self._ep_seqs[i], self._current_opp_idx)\n",
    "\n",
    "    def on_step(self, action, opp_action, true_idx=-1):\n",
    "        self._interaction_history.append((action, opp_action))\n",
    "        self._current_opp_idx = true_idx if true_idx >= 0 else 0\n",
    "        self._round_in_ep    += 1\n",
    "\n",
    "        if (self._round_in_ep % self.config.meta_adapt_freq == 0\n",
    "                and self._round_in_ep > 0):\n",
    "            self.meta.adapt()\n",
    "\n",
    "        self._error_ema = (self.config.error_ema_alpha * 0.0\n",
    "                           + (1 - self.config.error_ema_alpha) * self._error_ema)\n",
    "\n",
    "    def compute_intrinsic_reward(self, action): return 0.0\n",
    "    def build_state(self, base_obs): return base_obs\n",
    "\n",
    "\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# BARE DQN BASELINE (unchanged)\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "class BareDQNNet(nn.Module):\n",
    "    def __init__(self, state_dim, action_dim, hidden=256):\n",
    "        super().__init__()\n",
    "        self.net = nn.Sequential(\n",
    "            nn.Linear(state_dim, hidden), nn.LayerNorm(hidden), nn.ReLU(),\n",
    "            nn.Linear(hidden, hidden),    nn.LayerNorm(hidden), nn.ReLU(),\n",
    "            nn.Linear(hidden, hidden//2), nn.LayerNorm(hidden//2), nn.ReLU(),\n",
    "        )\n",
    "        self.value_head = nn.Linear(hidden//2, 1)\n",
    "        self.adv_head   = nn.Linear(hidden//2, action_dim)\n",
    "\n",
    "    def forward(self, x):\n",
    "        h=self.net(x); V=self.value_head(h); A=self.adv_head(h)\n",
    "        return V + A - A.mean(dim=-1, keepdim=True)\n",
    "\n",
    "Transition = namedtuple('Transition', ('state','action','reward','next_state','done'))\n",
    "\n",
    "class BareDQNAgent:\n",
    "    name = \"Bare DQN\"\n",
    "    def __init__(self, hidden=256, lr=1e-3, gamma=0.98, batch_size=256,\n",
    "                 target_update_freq=10, eps_start=1.0, eps_end=0.05,\n",
    "                 eps_decay=500, buffer_size=50_000, seed=SEED):\n",
    "        self.gamma=gamma; self.batch_size=batch_size\n",
    "        self.eps_start=eps_start; self.eps_end=eps_end; self.eps_decay=eps_decay\n",
    "        self.episode_num=0; self._rng=random.Random(seed)\n",
    "        self.policy_net=BareDQNNet(STATE_DIM_BARE,ACTION_DIM,hidden).to(device)\n",
    "        self.target_net=BareDQNNet(STATE_DIM_BARE,ACTION_DIM,hidden).to(device)\n",
    "        self.target_net.load_state_dict(self.policy_net.state_dict())\n",
    "        self.target_net.eval()\n",
    "        self.opt=optim.Adam(self.policy_net.parameters(), lr=lr)\n",
    "        self.buffer=deque(maxlen=buffer_size)\n",
    "        self.target_freq=target_update_freq; self.steps=0\n",
    "\n",
    "    @property\n",
    "    def epsilon(self):\n",
    "        return self.eps_end+(self.eps_start-self.eps_end)*np.exp(-self.episode_num/self.eps_decay)\n",
    "\n",
    "    def build_state(self,base_obs): return base_obs\n",
    "\n",
    "    def select_action(self, state, eval_mode=False):\n",
    "        if not eval_mode and self._rng.random()<self.epsilon:\n",
    "            return self._rng.randint(0,ACTION_DIM-1)\n",
    "        with torch.no_grad():\n",
    "            t=torch.tensor(state,dtype=torch.float32).unsqueeze(0).to(device)\n",
    "            return int(self.policy_net(t).argmax(1).item())\n",
    "\n",
    "    def push(self, state, action, reward, next_state, done):\n",
    "        self.buffer.append(Transition(state,action,reward,next_state,float(done)))\n",
    "\n",
    "    def train_step(self):\n",
    "        if len(self.buffer)<self.batch_size: return {}\n",
    "        batch=Transition(*zip(*random.sample(list(self.buffer),self.batch_size)))\n",
    "        S =torch.tensor(np.array(batch.state),      dtype=torch.float32).to(device)\n",
    "        A =torch.tensor(batch.action,                dtype=torch.long).to(device)\n",
    "        R =torch.tensor(batch.reward,                dtype=torch.float32).to(device)\n",
    "        S2=torch.tensor(np.array(batch.next_state), dtype=torch.float32).to(device)\n",
    "        Dn=torch.tensor(batch.done,                  dtype=torch.float32).to(device)\n",
    "        q =self.policy_net(S).gather(1,A.unsqueeze(1)).squeeze(1)\n",
    "        with torch.no_grad():\n",
    "            a2=self.policy_net(S2).argmax(1)\n",
    "            nq=self.target_net(S2).gather(1,a2.unsqueeze(1)).squeeze(1)\n",
    "            tgt=R+self.gamma*nq*(1-Dn)\n",
    "        loss=F.smooth_l1_loss(q,tgt)\n",
    "        self.opt.zero_grad(); loss.backward(); self.opt.step()\n",
    "        self.steps+=1\n",
    "        if self.steps%self.target_freq==0:\n",
    "            self.target_net.load_state_dict(self.policy_net.state_dict())\n",
    "        return {'loss': loss.item()}\n",
    "\n",
    "    def compute_intrinsic_reward(self,action): return 0.0\n",
    "    def on_episode_start(self): self.episode_num+=1\n",
    "    def on_episode_end(self): pass\n",
    "    def on_step(self, action, opp_action, true_idx=-1): pass\n",
    "\n",
    "\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# RULE-BASED BASELINES\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "class TFTAgent:\n",
    "    name = \"TFT\"\n",
    "    def __init__(self): self.last_opp=C\n",
    "    def build_state(self,b): return b\n",
    "    def select_action(self,s,eval_mode=False): return self.last_opp\n",
    "    def push(self,*a): pass\n",
    "    def train_step(self): return {}\n",
    "    def on_episode_start(self): self.last_opp=C\n",
    "    def on_episode_end(self): pass\n",
    "    def on_step(self,a,o,true_idx=-1): self.last_opp=o\n",
    "    def compute_intrinsic_reward(self,a): return 0.0\n",
    "    @property\n",
    "    def epsilon(self): return 0.0\n",
    "\n",
    "class CooperatorAgent:\n",
    "    name = \"Cooperator\"\n",
    "    def build_state(self,b): return b\n",
    "    def select_action(self,s,eval_mode=False): return C\n",
    "    def push(self,*a): pass\n",
    "    def train_step(self): return {}\n",
    "    def on_episode_start(self): pass\n",
    "    def on_episode_end(self): pass\n",
    "    def on_step(self,a,o,true_idx=-1): pass\n",
    "    def compute_intrinsic_reward(self,a): return 0.0\n",
    "    @property\n",
    "    def epsilon(self): return 0.0\n",
    "\n",
    "class DefectorAgent:\n",
    "    name = \"Defector\"\n",
    "    def build_state(self,b): return b\n",
    "    def select_action(self,s,eval_mode=False): return D\n",
    "    def push(self,*a): pass\n",
    "    def train_step(self): return {}\n",
    "    def on_episode_start(self): pass\n",
    "    def on_episode_end(self): pass\n",
    "    def on_step(self,a,o,true_idx=-1): pass\n",
    "    def compute_intrinsic_reward(self,a): return 0.0\n",
    "    @property\n",
    "    def epsilon(self): return 0.0\n",
    "\n",
    "\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# TRAINING LOOP\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "def run_training(agent, num_episodes=2000, agent_name=\"Agent\", seed=SEED):\n",
    "    rng_ep=random.Random(seed)\n",
    "    all_rewards, all_coops, losses=[],[],[]\n",
    "    round_reward_acc  =np.zeros(ROUNDS_PER_EPISODE)\n",
    "    round_reward_count=np.zeros(ROUNDS_PER_EPISODE)\n",
    "\n",
    "    pbar=tqdm(range(1,num_episodes+1),desc=f\"Training {agent_name}\",unit=\"ep\",leave=True)\n",
    "    for ep in pbar:\n",
    "        opp_idx  =rng_ep.randint(0,N_OPPONENTS-1)\n",
    "        opp_class=OPPONENT_CLASSES[opp_idx]\n",
    "        env      =IPDEnvironment(opp_class, true_idx=opp_idx)\n",
    "        agent.on_episode_start()\n",
    "        base_obs=env.reset()\n",
    "        ep_r,ep_c=0.0,0\n",
    "        ep_round_rewards=[]\n",
    "\n",
    "        for rnd in range(ROUNDS_PER_EPISODE):\n",
    "            action=agent.select_action(base_obs)\n",
    "            next_base,reward_ext,done,info=env.step(action)\n",
    "            opp_action=info['opponent_action']\n",
    "            agent.on_step(action,opp_action,true_idx=opp_idx)\n",
    "            agent.push(base_obs,action,reward_ext,next_base,done)\n",
    "            if rnd%TRAIN_FREQ==0:\n",
    "                tr=agent.train_step()\n",
    "                if tr and 'loss' in tr: losses.append(tr['loss'])\n",
    "            ep_r+=reward_ext; ep_c+=(1-action)\n",
    "            ep_round_rewards.append(reward_ext)\n",
    "            base_obs=next_base\n",
    "            if done: break\n",
    "\n",
    "        agent.on_episode_end()\n",
    "        all_rewards.append(ep_r); all_coops.append(ep_c/ROUNDS_PER_EPISODE)\n",
    "        for t,r in enumerate(ep_round_rewards):\n",
    "            round_reward_acc[t]+=r; round_reward_count[t]+=1\n",
    "\n",
    "        if ep%100==0:\n",
    "            pbar.set_postfix({\n",
    "                'R(100)': f'{np.mean(all_rewards[-100:]):.1f}',\n",
    "                'coop':   f'{np.mean(all_coops[-100:]):.2f}',\n",
    "            })\n",
    "\n",
    "    round_reward_mean=np.where(round_reward_count>0,\n",
    "                               round_reward_acc/np.maximum(round_reward_count,1), 0.0)\n",
    "    return {'rewards': np.array(all_rewards), 'coop_rates': np.array(all_coops),\n",
    "            'losses': losses, 'round_reward_mean': round_reward_mean}\n",
    "\n",
    "\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# EVALUATION\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "def evaluate_agent(agent, num_eval_episodes=100, seed=SEED):\n",
    "    results={}\n",
    "    for opp_idx,opp_class in enumerate(OPPONENT_CLASSES):\n",
    "        opp_name=OPPONENT_NAMES[opp_idx]\n",
    "        ep_rewards,ep_coops=[],[]\n",
    "        round_r_acc=np.zeros(ROUNDS_PER_EPISODE)\n",
    "        round_r_cnt=np.zeros(ROUNDS_PER_EPISODE)\n",
    "\n",
    "        for _ in range(num_eval_episodes):\n",
    "            env=IPDEnvironment(opp_class, true_idx=opp_idx)\n",
    "            agent.on_episode_start()\n",
    "            base_obs=env.reset()\n",
    "            r_sum,coops=0.0,0\n",
    "\n",
    "            for rnd in range(ROUNDS_PER_EPISODE):\n",
    "                action=agent.select_action(base_obs, eval_mode=True)\n",
    "                next_base,reward,done,info=env.step(action)\n",
    "                opp_action=info['opponent_action']\n",
    "                agent.on_step(action,opp_action,true_idx=opp_idx)\n",
    "                round_r_acc[rnd]+=reward; round_r_cnt[rnd]+=1\n",
    "                r_sum+=reward; coops+=(1-action)\n",
    "                base_obs=next_base\n",
    "                if done: break\n",
    "\n",
    "            agent.on_episode_end()\n",
    "            ep_rewards.append(r_sum); ep_coops.append(coops/ROUNDS_PER_EPISODE)\n",
    "\n",
    "        round_mean=np.where(round_r_cnt>0, round_r_acc/np.maximum(round_r_cnt,1), 0.0)\n",
    "        results[opp_name]={\n",
    "            'avg_reward': float(np.mean(ep_rewards)),\n",
    "            'std_reward': float(np.std(ep_rewards)),\n",
    "            'coop_rate':  float(np.mean(ep_coops)),\n",
    "            'round_reward': round_mean,\n",
    "        }\n",
    "    return results\n",
    "\n",
    "\n",
    "def compute_regret(eval_results):\n",
    "    return {opp: max(0.0, 3.0*ROUNDS_PER_EPISODE - stats['avg_reward'])\n",
    "            for opp,stats in eval_results.items()}\n",
    "\n",
    "\n",
    "def collect_embeddings(agent, n_episodes_per_opp=20, seed=SEED):\n",
    "    if not isinstance(agent, DRQNAgent): return None,None,None\n",
    "    zs,labels=[],[]\n",
    "    agent.policy_net.eval()\n",
    "    for opp_idx,opp_class in enumerate(OPPONENT_CLASSES):\n",
    "        for _ in range(n_episodes_per_opp):\n",
    "            env=IPDEnvironment(opp_class, true_idx=opp_idx)\n",
    "            agent.on_episode_start(); base_obs=env.reset()\n",
    "            for rnd in range(ROUNDS_PER_EPISODE):\n",
    "                action=agent.select_action(base_obs, eval_mode=True)\n",
    "                next_base,reward,done,info=env.step(action)\n",
    "                agent.on_step(action,info['opponent_action'],true_idx=opp_idx)\n",
    "                base_obs=next_base\n",
    "                if done: break\n",
    "            seq=agent._build_slow_seq(agent._interaction_history)\n",
    "            seq_t=torch.tensor(seq,dtype=torch.float32).unsqueeze(0).to(device)\n",
    "            with torch.no_grad():\n",
    "                z=agent.policy_net.encode_seq(seq_t)\n",
    "            zs.append(z.squeeze(0).cpu().numpy()); labels.append(opp_idx)\n",
    "            agent.on_episode_end()\n",
    "    agent.policy_net.train()\n",
    "    return np.array(zs), np.array(labels), OPPONENT_NAMES\n",
    "\n",
    "\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# REPORTING\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "def print_summary_table(eval_results_dict):\n",
    "    agents=list(eval_results_dict.keys())\n",
    "    opps  =list(next(iter(eval_results_dict.values())).keys())\n",
    "    print(\"\\n\"+\"=\"*130)\n",
    "    print(\"SUMMARY — Average Reward per Agent per Opponent (full episode)\")\n",
    "    print(\"=\"*130)\n",
    "    hdr=f\"{'Opponent':<30}\"+\"\".join(f\"{ag:>22}\" for ag in agents)\n",
    "    print(hdr); print(\"-\"*len(hdr))\n",
    "    orig_opps=OPPONENT_NAMES[:N_ORIGINAL]; hard_opps=OPPONENT_NAMES[N_ORIGINAL:]\n",
    "\n",
    "    def print_section(opp_list, label):\n",
    "        print(f\"\\n  [{label}]\")\n",
    "        for opp in opp_list:\n",
    "            if opp not in opps: continue\n",
    "            vals=[eval_results_dict[ag][opp]['avg_reward'] for ag in agents]\n",
    "            best=max(vals)\n",
    "            row=f\"  {opp:<28}\"\n",
    "            for v in vals:\n",
    "                row+=f\"{v:>21.1f}{'*' if v==best else ' '}\"\n",
    "            print(row)\n",
    "\n",
    "    print_section(orig_opps,\"Original 20 opponents\")\n",
    "    print_section(hard_opps,\"Hard 8 opponents\")\n",
    "    print(\"\\n\"+\"-\"*len(hdr))\n",
    "    for label,opp_list in [(\"Original mean\",orig_opps),(\"Hard mean\",hard_opps),(\"Overall mean\",opps)]:\n",
    "        means=[np.mean([eval_results_dict[ag][o]['avg_reward']\n",
    "                        for o in opp_list if o in opps]) for ag in agents]\n",
    "        best_m=max(means)\n",
    "        row=f\"  {label:<28}\"\n",
    "        for m in means:\n",
    "            row+=f\"{m:>21.1f}{'*' if m==best_m else ' '}\"\n",
    "        print(row)\n",
    "    print(\"=\"*130)\n",
    "\n",
    "    full='DRQN+v9r'\n",
    "    ablations=['Bare DQN','TFT']\n",
    "    ablations=[a for a in ablations if a in agents]\n",
    "    if full in agents and ablations:\n",
    "        print(f\"\\n{'─'*80}\")\n",
    "        print(f\"ABLATION DELTAS  (vs {full}, mean reward, + = full model better)\")\n",
    "        print(f\"{'─'*80}\")\n",
    "        for opp_group,opp_list in [(\"All\",opps),(\"Hard only\",hard_opps)]:\n",
    "            full_mean=np.mean([eval_results_dict[full][o]['avg_reward']\n",
