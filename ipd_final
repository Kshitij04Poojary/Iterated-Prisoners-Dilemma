NENT_NAMES if o in eval_results[ag]])),\n            }\n            for ag in eval_results\n        },\n    }\n    with open(f'{OUTPUT_DIR}/final_results_v10.json','w') as f:\n        json.dump(summary,f,indent=2,\n                  default=lambda x: float(x) if isinstance(x,np.floating) else str(x))\n    print(f\"  Saved → {OUTPUT_DIR}/final_results_v10.json\")","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true,"execution":{"iopub.status.busy":"2026-05-06T10:49:16.514801Z","iopub.execute_input":"2026-05-06T10:49:16.515790Z","iopub.status.idle":"2026-05-06T15:45:52.481590Z","shell.execute_reply.started":"2026-05-06T10:49:16.515751Z","shell.execute_reply":"2026-05-06T15:45:52.480749Z"}},"outputs":[{"name":"stdout","text":"[INFO] Device: cuda | SEED=42\n[INFO] Total opponent pool: 28 (20 original + 8 hard)\n[INFO] State dim — DRQN v10: 159 | Bare DQN: 31\n\n======================================================================\nDRQN v10 — Posterior-Gated Q-Mixture + C-Prior + Online Correction\n======================================================================\nOpponent pool:        28 (20 original + 8 hard)\nTraining episodes:    2000\nEval episodes:        100 per opponent\nState dim:            159\nFIX 1: Regime Q-mixture (3 heads), posterior-gated\nFIX 2: C-first prior, per-episode epsilon (eps_start=0.30)\nFIX 3: Entropy-scaled shaping, λ_max=0.35\nFIX 4: Online Q-correction (lr=0.0005), replaces MetaAdapter\nFIX 5: Regime-aware replay sampling (coop-punishing x1.5)\n======================================================================\n\n============================================================\nTRAINING PHASE\n============================================================\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"Training DRQN+v10:   0%|          | 0/2000 [00:00<?, ?ep/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"vers