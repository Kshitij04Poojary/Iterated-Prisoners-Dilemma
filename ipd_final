{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.12.12","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[],"dockerImageVersionId":31329,"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":true}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"\"\"\"\n================================================================================\nDRQN v10 — Posterior-Gated Q-Mixture + Cooperative Prior + Online Correction\n================================================================================\n\nRoot cause analysis of v9r failure:\n  1. Fixed λ shaping fires before posterior settles → grudger collapse\n  2. MetaAdapter with 3 inner steps on 20 transitions = noisy Q updates\n  3. Single Q-head averages across 28 opponents → defector/cooperator signals cancel\n  4. Epsilon never resets per-opponent → corrupts early posterior bootstrap\n\nv10 fixes:\n  FIX 1 — Posterior-gated Q-mixture\n    Three regime heads: coop_head, defect_head, tft_head\n    Output Q = softmax(posterior @ regime_weights) · [q_coop, q_def, q_tft]\n    Each head learns the right policy for its regime independently.\n    Posterior mixing weights are learned (3 scalar weights per opponent class).\n\n  FIX 2 — Cooperative initialization + C-first prior\n    Q-head biases initialized: C advantage = +0.5 over D\n    Round 0 action always C (no exploration until round 2)\n    Exploration restarts from 0.3 at start of each NEW episode (per-episode annealing)\n\n  FIX 3 — Entropy-scaled shaping (replaces fixed λ)\n    shaping_weight = max(0, (H0 - H_t) / H0) * SHAPE_LAMBDA_MAX\n    H0 = log(N_opponents) at round 0, H_t = current posterior entropy\n    Zero shaping until posterior starts concentrating (~round 5-10)\n    Full shaping (λ=0.35) only when posterior is confident\n\n  FIX 4 — Online Q-correction (replaces MetaAdapter)\n    Lightweight 2-layer MLP: [slow_z (96) + round_feat (4)] -> Q_correction (2)\n    Updated online every step with lr=5e-4, NO inner loop, NO copying\n    Additive correction: Q_final = Q_base + Q_correction\n    Resets at episode start — fresh slate per opponent\n\n  FIX 5 — Regime-aware replay sampling\n    Track opponent regime (coop/punishing/random) from posterior\n    Over-sample punishing opponents during training (x1.5 weight)\n    Ensures grudger-type scenarios are not underrepresented\n\nAll v8/v9 components retained: EpisodeTransformer, Bayesian head,\nFastStream, InfoNCE loss, dual-stream state, gamma=0.98, batch=256\n================================================================================\n\"\"\"\n\nimport random, os, time, json, warnings, copy\nimport numpy as np\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nimport torch.nn.functional as F\nfrom collections import deque, namedtuple\nfrom dataclasses import dataclass\nfrom typing import List, Tuple, Optional\nimport matplotlib\nmatplotlib.use('Agg')\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nfrom tqdm.auto import tqdm\nwarnings.filterwarnings('ignore')\n\ntry:\n    from IPython.display import display, Image as IPImage\n    _IN_NOTEBOOK = True\nexcept ImportError:\n    _IN_NOTEBOOK = False\n\n# ─────────────────────────────────────────────────────────────────────────────\nSEED = 42\nrandom.seed(SEED); np.random.seed(SEED)\ntorch.manual_seed(SEED); torch.cuda.manual_seed_all(SEED)\ntorch.backends.cudnn.deterministic = True\ntorch.backends.cudnn.benchmark     = False\n\ndevice = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\nprint(f\"[INFO] Device: {device} | SEED={SEED}\")\n\nC, D = 0, 1\nROUNDS_PER_EPISODE   = 100\nACTION_DIM           = 2\nTRAIN_FREQ           = 4\nTRANSFORMER_WINDOW   = 30\nFAST_WINDOW          = 5\n\nPAYOFF = {(C,C):(3,3), (C,D):(0,5), (D,C):(5,0), (D,D):(1,1)}\nPAYOFF_TENSOR = torch.tensor([[3., 0.], [5., 1.]])\n\n# FIX 3: entropy-scaled shaping cap\nSHAPE_LAMBDA_MAX = 0.35   # reached only when posterior is confident\n\n# FIX 4: online correction params\nONLINE_LR        = 5e-4\nONLINE_HIDDEN    = 32\n\n# Regime definitions for FIX 1\nN_REGIMES = 3\nREGIME_COOP    = 0   # cooperator-type: TFT, Grudger, Cooperator, WSLS...\nREGIME_DEFECT  = 1   # defector-type: Defector, AdaptiveDefector, EscalatingDefector...\nREGIME_RANDOM  = 2   # mixed/noisy: Random, NoisyTFT, HMM...\n\nSeqTransitionV10 = namedtuple('SeqTransitionV10',\n    ('slow_seq','fast_seq','base_obs','action','reward',\n     'next_slow','next_fast','next_base_obs','done','regime'))\n\ndef show_figure(path, title=\"\"):\n    plt.savefig(path, dpi=150, bbox_inches='tight')\n    plt.close()\n    if _IN_NOTEBOOK:\n        print(f\"\\n{'─'*55}\\n  {title}\\n{'─'*55}\")\n        display(IPImage(filename=path))\n    print(f\"  Saved → {os.path.basename(path)}\")\n\n\n# ─────────────────────────────────────────────────────────────────────────────\n# OPPONENT POOL (identical to v8/v9r)\n# ─────────────────────────────────────────────────────────────────────────────\nclass Strategy:\n    def reset(self): pass\n    def move(self, my_hist, opp_hist) -> int: raise NotImplementedError\n    @property\n    def name(self): return self.__class__.__name__\n\nclass TitForTat(Strategy):\n    def move(self, my_hist, opp_hist): return opp_hist[-1] if opp_hist else C\n\nclass Cooperator(Strategy):\n    def move(self, my_hist, opp_hist): return C\n\nclass Defector(Strategy):\n    def move(self, my_hist, opp_hist): return D\n\nclass WinStayLoseShift(Strategy):\n    def move(self, my_hist, opp_hist):\n        if not my_hist: return C\n        won = (my_hist[-1]==C and opp_hist[-1]==C) or (my_hist[-1]==D and opp_hist[-1]==C)\n        return my_hist[-1] if won else (D if my_hist[-1]==C else C)\n\nclass WinShiftLoseStay(Strategy):\n    def move(self, my_hist, opp_hist):\n        if not my_hist: return D\n        won = (my_hist[-1]==C and opp_hist[-1]==C) or (my_hist[-1]==D and opp_hist[-1]==C)\n        return (D if my_hist[-1]==C else C) if won else my_hist[-1]\n\nclass RandomStrategy(Strategy):\n    @property\n    def name(self): return \"Random\"\n    def move(self, my_hist, opp_hist): return random.choice([C,D])\n\nclass Grudger(Strategy):\n    def __init__(self): self._triggered = False\n    def reset(self): self._triggered = False\n    def move(self, my_hist, opp_hist):\n        if D in opp_hist: self._triggered = True\n        return D if self._triggered else C\n\nclass SuspiciousTFT(Strategy):\n    def move(self, my_hist, opp_hist): return D if not opp_hist else opp_hist[-1]\n\nclass HardTFT2(Strategy):\n    def move(self, my_hist, opp_hist):\n        if len(opp_hist)>=2 and opp_hist[-1]==D and opp_hist[-2]==D: return D\n        return C\n\nclass Prober(Strategy):\n    def __init__(self): self._exploit = None\n    def reset(self): self._exploit = None\n    def move(self, my_hist, opp_hist):\n        t = len(my_hist)\n        if t==0: return D\n        if t in (1,2): return C\n        if t==3: self._exploit = (opp_hist[1]==C and opp_hist[2]==C)\n        return D if self._exploit else opp_hist[-1]\n\nclass GTFT(Strategy):\n    def __init__(self, p=0.33): self.p = p\n    def move(self, my_hist, opp_hist):\n        if not opp_hist or opp_hist[-1]==C: return C\n        return C if random.random()<self.p else D\n\nclass Forgiver(Strategy):\n    def __init__(self, threshold=0.1): self.threshold = threshold\n    def move(self, my_hist, opp_hist):\n        if not opp_hist: return C\n        return D if opp_hist.count(D)/len(opp_hist)>self.threshold else C\n\nclass NoisyTFT(Strategy):\n    def __init__(self, noise=0.05): self.noise = noise\n    def move(self, my_hist, opp_hist):\n        intended = opp_hist[-1] if opp_hist else C\n        return 1-intended if random.random()<self.noise else intended\n\nclass NoisyWSLS(Strategy):\n    def __init__(self, noise=0.05): self.noise = noise\n    def move(self, my_hist, opp_hist):\n        if not my_hist: intended=C\n        else:\n            won=(my_hist[-1]==C and opp_hist[-1]==C) or (my_hist[-1]==D and opp_hist[-1]==C)\n            intended=my_hist[-1] if won else (D if my_hist[-1]==C else C)\n        return 1-intended if random.random()<self.noise else intended\n\nclass RegimeSwitcher(Strategy):\n    def __init__(self, switch_round=50): self.switch_round = switch_round\n    def move(self, my_hist, opp_hist): return C if len(my_hist)<self.switch_round else D\n\nclass AdaptiveDefector(Strategy):\n    def __init__(self, exploit_threshold=0.7):\n        self.threshold=exploit_threshold; self.phase=\"cooperate\"; self.coop_count=0\n    def reset(self): self.phase=\"cooperate\"; self.coop_count=0\n    def move(self, my_hist, opp_hist):\n        t=len(my_hist)\n        if t==0: self.reset(); return C\n        if my_hist[-1]==C: self.coop_count+=1\n        if t>=10 and (self.coop_count/t)>self.threshold: self.phase=\"defect\"\n        return D if self.phase==\"defect\" else C\n\nclass HMMOpponent(Strategy):\n    def __init__(self, switch_prob=0.05): self.switch_prob=switch_prob; self.state=\"TFT\"\n    def reset(self): self.state=\"TFT\"\n    def move(self, my_hist, opp_hist):\n        if random.random()<self.switch_prob:\n            self.state=\"Defector\" if self.state==\"TFT\" else \"TFT\"\n        return (opp_hist[-1] if opp_hist else C) if self.state==\"TFT\" else D\n\nclass SoftTFT(Strategy):\n    def __init__(self, p_coop=0.9): self.p = p_coop\n    def move(self, my_hist, opp_hist):\n        if not opp_hist: return C\n        coop_prob = self.p if opp_hist[-1]==C else (1-self.p)\n        return C if random.random()<coop_prob else D\n\nclass LogisticStrategy(Strategy):\n    @property\n    def name(self): return \"Logistic\"\n    def __init__(self, w1=1.0, w2=-0.5): self.w1=w1; self.w2=w2\n    def move(self, my_hist, opp_hist):\n        if not my_hist or not opp_hist: return C\n        logit = self.w1*(1-2*my_hist[-1]) + self.w2*(1-2*opp_hist[-1])\n        return C if random.random()<1/(1+np.exp(-logit)) else D\n\nclass DelayedGrudger(Strategy):\n    def __init__(self, delay=3): self.delay=delay; self.defections_seen=0\n    def reset(self): self.defections_seen=0\n    def move(self, my_hist, opp_hist):\n        if opp_hist and opp_hist[-1]==D: self.defections_seen+=1\n        return D if self.defections_seen>=self.delay else C\n\nclass MemoryDecayTFT(Strategy):\n    @property\n    def name(self): return \"MemoryDecayTFT\"\n    def __init__(self, decay=0.85, threshold=0.4):\n        self.decay=decay; self.threshold=threshold; self.grudge=0.0\n    def reset(self): self.grudge=0.0\n    def move(self, my_hist, opp_hist):\n        self.grudge *= self.decay\n        if opp_hist and opp_hist[-1]==D:\n            self.grudge = min(1.0, self.grudge+0.4)\n        return D if self.grudge>self.threshold else C\n\nclass TriggeredSwitcher(Strategy):\n    @property\n    def name(self): return \"TriggeredSwitcher\"\n    def __init__(self, k=3): self.k=k; self.defect_streak=0; self.switched=False\n    def reset(self): self.defect_streak=0; self.switched=False\n    def move(self, my_hist, opp_hist):\n        if opp_hist and opp_hist[-1]==D: self.defect_streak+=1\n        else: self.defect_streak=0\n        if self.defect_streak>=self.k: self.switched=True\n        if self.switched: return D\n        return opp_hist[-1] if opp_hist else C\n\nclass MixedMotivation(Strategy):\n    @property\n    def name(self): return \"MixedMotivation\"\n    def __init__(self): self.p_tft=0.5\n    def reset(self): self.p_tft=random.uniform(0.2,0.8)\n    def move(self, my_hist, opp_hist):\n        if not my_hist: return C\n        if random.random()<self.p_tft:\n            return opp_hist[-1] if opp_hist else C\n        else:\n            won=(my_hist[-1]==C and opp_hist[-1]==C) or (my_hist[-1]==D and opp_hist[-1]==C)\n            return my_hist[-1] if won else (D if my_hist[-1]==C else C)\n\nclass PeriodicStrategy(Strategy):\n    @property\n    def name(self): return \"PeriodicStrategy\"\n    def __init__(self): self.T=10\n    def reset(self): self.T=random.randint(5,20)\n    def move(self, my_hist, opp_hist):\n        t=len(my_hist); block=(t//self.T)%2\n        return C if block==0 else D\n\nclass BayesianMimic(Strategy):\n    @property\n    def name(self): return \"BayesianMimic\"\n    def __init__(self, window=15): self.window=window\n    def move(self, my_hist, opp_hist):\n        if not opp_hist: return C\n        window=opp_hist[-self.window:]\n        p_coop=sum(1-a for a in window)/len(window)\n        return C if random.random()<p_coop else D\n\nclass EscalatingDefector(Strategy):\n    @property\n    def name(self): return \"EscalatingDefector\"\n    def move(self, my_hist, opp_hist):\n        t=len(my_hist); p_defect=t/ROUNDS_PER_EPISODE\n        return D if random.random()<p_defect else C\n\nclass ConditionalGrudger(Strategy):\n    @property\n    def name(self): return \"ConditionalGrudger\"\n    def __init__(self): self.triggered=False\n    def reset(self): self.triggered=False\n    def move(self, my_hist, opp_hist):\n        if my_hist and opp_hist:\n            if my_hist[-1]==C and opp_hist[-1]==D: self.triggered=True\n        return D if self.triggered else C\n\nclass TwoTimidOneDevious(Strategy):\n    @property\n    def name(self): return \"TwoTimidOneDevious\"\n    def move(self, my_hist, opp_hist):\n        t=len(my_hist)\n        if t<int(ROUNDS_PER_EPISODE*0.67):\n            return opp_hist[-1] if opp_hist else C\n        return D\n\nORIGINAL_OPPONENT_CLASSES = [\n    TitForTat, Cooperator, Defector, WinStayLoseShift, WinShiftLoseStay,\n    RandomStrategy, Grudger, SuspiciousTFT, HardTFT2, Prober, GTFT, Forgiver,\n    NoisyTFT, NoisyWSLS, RegimeSwitcher, AdaptiveDefector, SoftTFT,\n    LogisticStrategy, DelayedGrudger, HMMOpponent\n]\nHARD_OPPONENT_CLASSES = [\n    MemoryDecayTFT, TriggeredSwitcher, MixedMotivation, PeriodicStrategy,\n    BayesianMimic, EscalatingDefector, ConditionalGrudger, TwoTimidOneDevious\n]\nOPPONENT_CLASSES = ORIGINAL_OPPONENT_CLASSES + HARD_OPPONENT_CLASSES\nOPPONENT_NAMES   = [cls().name for cls in OPPONENT_CLASSES]\nN_OPPONENTS      = len(OPPONENT_NAMES)\nN_ORIGINAL       = len(ORIGINAL_OPPONENT_CLASSES)\nN_HARD           = len(HARD_OPPONENT_CLASSES)\n\n# FIX 5: regime labels for each opponent (for weighted sampling)\n# 0=coop-punishing, 1=defector, 2=random/mixed\nOPPONENT_REGIMES = [\n    0, 0, 1, 0, 2,   # TFT, Coop, Defector, WSLS, WSFL\n    2, 0, 0, 0, 2,   # Random, Grudger, SuspTFT, HardTFT2, Prober\n    0, 0, 2, 2, 2,   # GTFT, Forgiver, NoisyTFT, NoisyWSLS, RegimeSwitcher\n    1, 0, 2, 0, 2,   # AdaptiveDefector, SoftTFT, Logistic, DelayedGrudger, HMM\n    0, 0, 2, 2,       # MemoryDecayTFT, TriggeredSwitcher, MixedMotivation, Periodic\n    2, 1, 0, 2        # BayesianMimic, EscalatingDefector, ConditionalGrudger, TwoTimid\n]\n\nprint(f\"[INFO] Total opponent pool: {N_OPPONENTS} ({N_ORIGINAL} original + {N_HARD} hard)\")\n\n\n# ─────────────────────────────────────────────────────────────────────────────\n# STATE ENCODER (31 base features — unchanged)\n# ─────────────────────────────────────────────────────────────────────────────\nclass StateEncoder:\n    @staticmethod\n    def encode(player_history, opponent_history, round_num):\n        last_2_self  = ([0]*2+player_history[-2:])[-2:]   if player_history   else [0,0]\n        last_2_opp   = ([0]*2+opponent_history[-2:])[-2:] if opponent_history else [0,0]\n        last_5_self  = ([0]*5+player_history[-5:])[-5:]   if player_history   else [0]*5\n        last_5_opp   = ([0]*5+opponent_history[-5:])[-5:] if opponent_history else [0]*5\n        n=max(1,round_num)\n        coop_self        = sum(1-a for a in player_history)/n\n        coop_opp         = sum(1-a for a in opponent_history)/n\n        recent_self      = player_history[-10:] if player_history else []\n        recent_opp       = opponent_history[-10:] if opponent_history else []\n        coop_self_recent = sum(1-a for a in recent_self)/max(1,len(recent_self))\n        coop_opp_recent  = sum(1-a for a in recent_opp)/max(1,len(recent_opp))\n        mutual_coop      = sum(1 for a,o in zip(player_history,opponent_history) if a==C and o==C)/n\n        streak=0\n        for a in reversed(opponent_history):\n            if a==D: streak+=1\n            else: break\n        streak_feat=min(streak,10)/10.0\n        progress=round_num/ROUNDS_PER_EPISODE\n        def coop_after(actions, shift=1):\n            resp=[1-opponent_history[t+shift] for t,a in enumerate(actions)\n                  if a==D and t+shift<len(opponent_history)]\n            return np.mean(resp) if resp else 0.5\n        coop_after_self_def  = coop_after(player_history)\n        coop_after_self_coop = coop_after([a for a in player_history if a==C])\n        ever_forgave=float(any(opponent_history[t+1]==C for t,a in enumerate(player_history)\n                               if a==D and t+1<len(opponent_history)))\n        hard_tft_signal=0.0\n        if len(opponent_history)>=3 and len(player_history)>=3:\n            hard_tft_signal=float(player_history[-2]==D and player_history[-3]==D\n                                   and opponent_history[-1]==D)\n        first_defect=float(len(opponent_history)>0 and opponent_history[0]==D)\n        prober_pattern=0.0\n        if len(opponent_history)>=3:\n            prober_pattern=float(opponent_history[0]==D and opponent_history[1]==C\n                                  and opponent_history[2]==C)\n        early_def_rate=sum(opponent_history[:5])/max(1,min(5,len(opponent_history)))\n        is_prober_likely=0.0\n        if round_num>=4:\n            late_opp=opponent_history[3:]\n            is_prober_likely=float(sum(late_opp)/max(1,len(late_opp))>0.7 and prober_pattern>0.5)\n        defection_after_coop=1.0-coop_after_self_coop\n        features=(last_2_self+last_2_opp+last_5_self+last_5_opp+\n            [coop_self,coop_opp,coop_self_recent,coop_opp_recent,\n             mutual_coop,streak_feat,progress,progress**2,\n             coop_after_self_def,coop_after_self_coop,\n             ever_forgave,hard_tft_signal,\n             first_defect,prober_pattern,early_def_rate,is_prober_likely,\n             defection_after_coop])\n        return np.array(features, dtype=np.float32)\n\nSTATE_BASE_DIM   = 31\nSLOW_HIDDEN_DIM  = 96\nFAST_HIDDEN_DIM  = 32\nCOMBINED_DIM     = SLOW_HIDDEN_DIM + FAST_HIDDEN_DIM\nSTATE_DIM_DRQN   = STATE_BASE_DIM + COMBINED_DIM\nSTATE_DIM_BARE   = STATE_BASE_DIM\n\nprint(f\"[INFO] State dim — DRQN v10: {STATE_DIM_DRQN} | Bare DQN: {STATE_DIM_BARE}\")\n\n\n# ─────────────────────────────────────────────────────────────────────────────\n# ENVIRONMENT\n# ─────────────────────────────────────────────────────────────────────────────\nclass IPDEnvironment:\n    def __init__(self, opponent_class, true_idx: int = -1):\n        self.opponent_class=opponent_class; self.true_idx=true_idx; self.reset()\n\n    def reset(self):\n        self.opponent=self.opponent_class()\n        if hasattr(self.opponent,'reset'): self.opponent.reset()\n        self.player_history=[]; self.opponent_history=[]; self.round=0\n        return self._get_obs()\n\n    def step(self, player_action):\n        opp_action=self.opponent.move(self.opponent_history[:], self.player_history[:])\n        reward,_=PAYOFF[(player_action,opp_action)]\n        self.player_history.append(player_action)\n        self.opponent_history.append(opp_action)\n        self.round+=1\n        done=self.round>=ROUNDS_PER_EPISODE\n        return self._get_obs(), reward, done, {'opponent_action': opp_action}\n\n    def _get_obs(self):\n        return StateEncoder.encode(self.player_history,self.opponent_history,self.round)\n\n\n# ─────────────────────────────────────────────────────────────────────────────\n# EPISODE TRANSFORMER (unchanged from v8/v9r)\n# ─────────────────────────────────────────────────────────────────────────────\nclass SinusoidalPE(nn.Module):\n    def __init__(self, d_model: int, max_len: int = 200):\n        super().__init__()\n        pe  = torch.zeros(max_len, d_model)\n        pos = torch.arange(0, max_len, dtype=torch.float).unsqueeze(1)\n        div = torch.exp(torch.arange(0, d_model, 2).float() * (-np.log(10000.0) / d_model))\n        pe[:, 0::2] = torch.sin(pos * div)\n        pe[:, 1::2] = torch.cos(pos * div)\n        self.register_buffer('pe', pe.unsqueeze(0))\n\n    def forward(self, x):\n        return x + self.pe[:, :x.size(1), :]\n\n\nclass EpisodeTransformer(nn.Module):\n    def __init__(self, d_model: int = SLOW_HIDDEN_DIM, nhead: int = 4,\n                 num_layers: int = 3, dim_ff: int = 256,\n                 max_len: int = TRANSFORMER_WINDOW + 2):\n        super().__init__()\n        self.input_proj = nn.Linear(2, d_model)\n        self.pe         = SinusoidalPE(d_model, max_len)\n        encoder_layer   = nn.TransformerEncoderLayer(\n            d_model=d_model, nhead=nhead,\n            dim_feedforward=dim_ff, dropout=0.0,\n            batch_first=True, norm_first=True\n        )\n        self.transformer = nn.TransformerEncoder(encoder_layer, num_layers=num_layers)\n        self.out_norm    = nn.LayerNorm(d_model)\n        self.action_proj = nn.Embedding(ACTION_DIM, d_model)\n        self.action_norm = nn.LayerNorm(d_model)\n\n    def forward(self, seq: torch.Tensor) -> torch.Tensor:\n        x = self.input_proj(seq)\n        x = self.pe(x)\n        x = self.transformer(x)\n        z = self.out_norm(x[:, -1, :])\n        return z\n\n    def encode_with_action(self, z: torch.Tensor, actions: torch.Tensor) -> torch.Tensor:\n        proj  = self.action_proj(actions)\n        z_act = self.action_norm(z + proj)\n        return F.normalize(z_act, dim=-1)\n\n    def encode_seq(self, seq: torch.Tensor) -> torch.Tensor:\n        return self.forward(seq)\n\n\n# ─────────────────────────────────────────────────────────────────────────────\n# FAST STREAM (unchanged)\n# ─────────────────────────────────────────────────────────────────────────────\nclass FastStream(nn.Module):\n    def __init__(self, fast_window: int = FAST_WINDOW,\n                 out_dim: int = FAST_HIDDEN_DIM):\n        super().__init__()\n        self.net = nn.Sequential(\n            nn.Flatten(start_dim=1),\n            nn.Linear(fast_window * 2, 64), nn.ReLU(),\n            nn.Linear(64, out_dim), nn.LayerNorm(out_dim), nn.ReLU(),\n        )\n\n    def forward(self, fast_seq: torch.Tensor) -> torch.Tensor:\n        return self.net(fast_seq)\n\n\n# ─────────────────────────────────────────────────────────────────────────────\n# BAYESIAN OPPONENT HEAD (unchanged)\n# ─────────────────────────────────────────────────────────────────────────────\nclass BayesianOpponentHead(nn.Module):\n    def __init__(self, z_dim: int = SLOW_HIDDEN_DIM, n_opp: int = N_OPPONENTS):\n        super().__init__()\n        self.n_opp = n_opp\n        self.emission = nn.Sequential(\n            nn.Linear(z_dim, 128), nn.ReLU(),\n            nn.Linear(128, n_opp),\n        )\n        self.class_coop_bias = nn.Parameter(torch.zeros(n_opp))\n\n    def forward(self, z: torch.Tensor) -> torch.Tensor:\n        return self.emission(z)\n\n    def expected_reward(self, posterior: torch.Tensor,\n                        payoff_t: torch.Tensor) -> torch.Tensor:\n        p_coop = torch.sigmoid(self.class_coop_bias)\n        r_if_coop = payoff_t[:, 0]\n        r_if_def  = payoff_t[:, 1]\n        per_class_exp_r = p_coop.unsqueeze(1) * r_if_coop.unsqueeze(0) + \\\n                          (1 - p_coop).unsqueeze(1) * r_if_def.unsqueeze(0)\n        return posterior @ per_class_exp_r\n\n\n# ─────────────────────────────────────────────────────────────────────────────\n# FIX 1: REGIME Q-HEADS + POSTERIOR MIXING\n# ─────────────────────────────────────────────────────────────────────────────\nclass RegimeMixingLayer(nn.Module):\n    \"\"\"\n    Learns per-opponent-class regime weights (N_opponents x N_regimes).\n    At inference: mixture_weights = softmax(posterior @ regime_assignment) (B, N_regimes)\n    Final Q = sum_r mixture_weights[:,r] * Q_r\n    \"\"\"\n    def __init__(self, n_opponents: int = N_OPPONENTS, n_regimes: int = N_REGIMES):\n        super().__init__()\n        self.n_regimes = n_regimes\n        # Learnable assignment: which regime does each opponent belong to?\n        # Initialize from OPPONENT_REGIMES prior\n        init = torch.zeros(n_opponents, n_regimes)\n        for i, r in enumerate(OPPONENT_REGIMES):\n            init[i, r] = 2.0   # soft prior: preferred regime gets 2x logit\n        self.assignment = nn.Parameter(init)   # (N_opp, N_regimes)\n\n    def forward(self, posterior: torch.Tensor) -> torch.Tensor:\n        \"\"\"\n        posterior: (B, N_opp) softmax probabilities\n        returns:   (B, N_regimes) mixture weights\n        \"\"\"\n        # Soft regime assignment via posterior\n        regime_logits = posterior @ self.assignment     # (B, N_regimes)\n        return F.softmax(regime_logits, dim=-1)          # (B, N_regimes)\n\n\n# ─────────────────────────────────────────────────────────────────────────────\n# FULL NETWORK v10\n# ─────────────────────────────────────────────────────────────────────────────\nclass TransformerDQNv10(nn.Module):\n    def __init__(self, base_dim: int = STATE_BASE_DIM,\n                 slow_dim: int = SLOW_HIDDEN_DIM,\n                 fast_dim: int = FAST_HIDDEN_DIM,\n                 action_dim: int = ACTION_DIM,\n                 hidden: int = 256):\n        super().__init__()\n        self.slow_encoder  = EpisodeTransformer(d_model=slow_dim)\n        self.fast_encoder  = FastStream(FAST_WINDOW, fast_dim)\n        self.bayes_head    = BayesianOpponentHead(slow_dim, N_OPPONENTS)\n        self.regime_mixer  = RegimeMixingLayer(N_OPPONENTS, N_REGIMES)\n\n        combined = base_dim + slow_dim + fast_dim\n        # Shared trunk\n        self.shared = nn.Sequential(\n            nn.Linear(combined, hidden),      nn.LayerNorm(hidden),   nn.ReLU(),\n            nn.Linear(hidden, hidden),        nn.LayerNorm(hidden),   nn.ReLU(),\n            nn.Linear(hidden, hidden // 2),   nn.LayerNorm(hidden//2), nn.ReLU(),\n        )\n        # FIX 1: N_REGIMES separate value+advantage heads\n        self.value_heads    = nn.ModuleList([nn.Linear(hidden//2, 1)         for _ in range(N_REGIMES)])\n        self.advantage_heads= nn.ModuleList([nn.Linear(hidden//2, action_dim) for _ in range(N_REGIMES)])\n\n        # FIX 2: Initialize advantage heads to prefer C (action 0)\n        for adv in self.advantage_heads:\n            nn.init.zeros_(adv.weight)\n            adv.bias.data = torch.tensor([0.5, -0.5])  # C preferred by 0.5\n\n    def forward(self, base_obs: torch.Tensor,\n                slow_seq: torch.Tensor,\n                fast_seq: torch.Tensor) -> Tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor]:\n        slow_z       = self.slow_encoder(slow_seq)\n        fast_z       = self.fast_encoder(fast_seq)\n        class_logits = self.bayes_head(slow_z)\n        posterior    = torch.softmax(class_logits, dim=-1)\n\n        x      = torch.cat([base_obs, slow_z, fast_z], dim=-1)\n        shared = self.shared(x)\n\n        # Compute Q per regime\n        q_regimes = []\n        for r in range(N_REGIMES):\n            V = self.value_heads[r](shared)\n            A = self.advantage_heads[r](shared)\n            q = V + A - A.mean(dim=-1, keepdim=True)\n            q_regimes.append(q)\n        q_stack = torch.stack(q_regimes, dim=1)   # (B, N_regimes, action_dim)\n\n        # FIX 1: Mix using posterior-derived regime weights\n        regime_weights = self.regime_mixer(posterior)              # (B, N_regimes)\n        q_mixed = (regime_weights.unsqueeze(-1) * q_stack).sum(1)  # (B, action_dim)\n\n        return q_mixed, slow_z, class_logits, regime_weights\n\n    def encode_seq(self, slow_seq: torch.Tensor) -> torch.Tensor:\n        return self.slow_encoder.encode_seq(slow_seq)\n\n    def encode_with_action(self, z: torch.Tensor, actions: torch.Tensor) -> torch.Tensor:\n        return self.slow_encoder.encode_with_action(z, actions)\n\n\n# ─────────────────────────────────────────────────────────────────────────────\n# FIX 4: ONLINE Q-CORRECTION (replaces MetaAdapter)\n# ─────────────────────────────────────────────────────────────────────────────\nclass OnlineQCorrection(nn.Module):\n    \"\"\"\n    Lightweight online correction network.\n    Input: [slow_z (SLOW_HIDDEN_DIM), round_features (4)]\n    Output: delta_Q (ACTION_DIM)\n    Updated every step with a small lr — no inner loop, no copying.\n    Resets weights at episode start.\n    \"\"\"\n    def __init__(self, z_dim: int = SLOW_HIDDEN_DIM, hidden: int = ONLINE_HIDDEN):\n        super().__init__()\n        self.net = nn.Sequential(\n            nn.Linear(z_dim + 4, hidden), nn.ReLU(),\n            nn.Linear(hidden, ACTION_DIM),\n        )\n        # Initialize to near-zero output (correction starts small)\n        nn.init.zeros_(self.net[-1].weight)\n        nn.init.zeros_(self.net[-1].bias)\n\n    def forward(self, z: torch.Tensor, round_feat: torch.Tensor) -> torch.Tensor:\n        x = torch.cat([z, round_feat], dim=-1)\n        return self.net(x)\n\n    def reset(self):\n        \"\"\"Reset to near-zero at episode start.\"\"\"\n        nn.init.zeros_(self.net[-1].weight)\n        nn.init.zeros_(self.net[-1].bias)\n        # Also reset hidden layer with small random init\n        nn.init.orthogonal_(self.net[0].weight, gain=0.1)\n        nn.init.zeros_(self.net[0].bias)\n\n\ndef make_round_features(round_num: int) -> torch.Tensor:\n    \"\"\"4 sinusoidal features for round position.\"\"\"\n    t = round_num / ROUNDS_PER_EPISODE\n    return torch.tensor([\n        np.sin(np.pi * t),\n        np.cos(np.pi * t),\n        np.sin(2 * np.pi * t),\n        t,\n    ], dtype=torch.float32)\n\n\n# ─────────────────────────────────────────────────────────────────────────────\n# REPLAY BUFFERS\n# ─────────────────────────────────────────────────────────────────────────────\nclass GRUSequenceBuffer:\n    def __init__(self, capacity: int = 10_000):\n        self.capacity=capacity\n        self._seqs=np.zeros((capacity, TRANSFORMER_WINDOW, 2), dtype=np.float32)\n        self._opp=np.full(capacity, -1, dtype=np.int32)\n        self._pos=0; self._size=0\n\n    def push(self, seq: np.ndarray, opp_idx: int):\n        self._seqs[self._pos]=seq; self._opp[self._pos]=opp_idx\n        self._pos=(self._pos+1)%self.capacity\n        self._size=min(self._size+1, self.capacity)\n\n    def sample_negatives_batch(self, anchor_opp_indices: np.ndarray, n: int):\n        if self._size<n+1: return None\n        valid=self._opp[:self._size]; B=len(anchor_opp_indices)\n        result=np.zeros((B,n,TRANSFORMER_WINDOW,2), dtype=np.float32)\n        for i,oi in enumerate(anchor_opp_indices):\n            mask=(valid!=oi); cands=np.where(mask)[0]\n            if len(cands)<n: return None\n            chosen=np.random.choice(cands, size=n, replace=False)\n            result[i]=self._seqs[chosen]\n        return result\n\n    def __len__(self): return self._size\n\n\nclass SequenceReplayBuffer:\n    \"\"\"FIX 5: regime-aware replay buffer with weighted sampling.\"\"\"\n    def __init__(self, capacity: int = 60_000):\n        self.buffer: deque = deque(maxlen=capacity)\n        self.opp_indices: deque = deque(maxlen=capacity)\n        self.regimes: deque = deque(maxlen=capacity)\n\n    def push(self, slow_seq, fast_seq, base_obs, action, reward,\n             next_slow, next_fast, next_base_obs, done, opp_idx, regime):\n        self.buffer.append(SeqTransitionV10(\n            slow_seq, fast_seq, base_obs, action, reward,\n            next_slow, next_fast, next_base_obs, float(done), regime\n        ))\n        self.opp_indices.append(opp_idx)\n        self.regimes.append(regime)\n\n    def sample(self, batch_size: int):\n        n = len(self.buffer)\n        regimes_arr = np.array(self.regimes)\n        # FIX 5: over-sample coop-punishing (regime 0) by 1.5x\n        weights = np.where(regimes_arr == REGIME_COOP, 1.5, 1.0)\n        weights = weights / weights.sum()\n        indices = np.random.choice(n, size=batch_size, replace=False, p=weights)\n        batch   = [self.buffer[i]         for i in indices]\n        opp_ids = np.array([self.opp_indices[i] for i in indices], dtype=np.int32)\n        return SeqTransitionV10(*zip(*batch)), opp_ids\n\n    def __len__(self): return len(self.buffer)\n\n\n# ─────────────────────────────────────────────────────────────────────────────\n# INFONCE CONTRASTIVE LOSS (unchanged)\n# ─────────────────────────────────────────────────────────────────────────────\ndef info_nce_loss(anchor, positive, negatives, temperature=0.1):\n    pos_sim = (anchor * positive).sum(dim=-1, keepdim=True) / temperature\n    neg_sim = torch.bmm(negatives, anchor.unsqueeze(-1)).squeeze(-1) / temperature\n    logits  = torch.cat([pos_sim, neg_sim], dim=-1)\n    labels  = torch.zeros(anchor.shape[0], dtype=torch.long, device=anchor.device)\n    return F.cross_entropy(logits, labels)\n\n\n# ─────────────────────────────────────────────────────────────────────────────\n# DRQN v10 CONFIG\n# ─────────────────────────────────────────────────────────────────────────────\n@dataclass\nclass DRQNv10Config:\n    hidden_size:        int   = 256\n    slow_dim:           int   = SLOW_HIDDEN_DIM\n    fast_dim:           int   = FAST_HIDDEN_DIM\n    lr:                 float = 1e-4\n    gamma:              float = 0.98\n    batch_size:         int   = 256\n    target_update_freq: int   = 8\n    # FIX 2: per-episode epsilon (resets each episode, not global decay)\n    eps_start:          float = 0.30   # lower start — we trust C-prior more\n    eps_end:            float = 0.01\n    eps_episode_decay:  int   = 20     # halve every 20 rounds within episode\n    bayes_lambda:       float = 0.15\n    contrast_lambda:    float = 0.20\n    contrast_tau:       float = 0.03\n    n_negatives:        int   = 12\n    # FIX 3: entropy-scaled shaping\n    shape_lambda_max:   float = SHAPE_LAMBDA_MAX   # 0.35\n    # FIX 4: online correction\n    online_lr:          float = ONLINE_LR\n    online_correction_weight: float = 0.5   # blend: Q_final = Q_base + w * Q_correction\n    seed:               int   = SEED\n\n\n# ─────────────────────────────────────────────────────────────────────────────\n# DRQN v10 AGENT\n# ─────────────────────────────────────────────────────────────────────────────\nclass DRQNv10Agent:\n    name = \"DRQN+v10\"\n\n    def __init__(self, config: DRQNv10Config = None):\n        self.config = config or DRQNv10Config()\n        self._rng   = random.Random(self.config.seed)\n        self.total_episodes = 0\n        self.steps   = 0\n\n        self.policy_net = TransformerDQNv10(\n            STATE_BASE_DIM, SLOW_HIDDEN_DIM, FAST_HIDDEN_DIM,\n            ACTION_DIM, self.config.hidden_size\n        ).to(device)\n        self.target_net = TransformerDQNv10(\n            STATE_BASE_DIM, SLOW_HIDDEN_DIM, FAST_HIDDEN_DIM,\n            ACTION_DIM, self.config.hidden_size\n        ).to(device)\n        self.target_net.load_state_dict(self.policy_net.state_dict())\n        self.target_net.eval()\n\n        self.optimizer = optim.Adam(self.policy_net.parameters(),\n                                    lr=self.config.lr, weight_decay=1e-5)\n\n        # FIX 4: online correction (separate from policy net)\n        self.online_corr = OnlineQCorrection(SLOW_HIDDEN_DIM, ONLINE_HIDDEN).to(device)\n        self.online_opt  = optim.Adam(self.online_corr.parameters(), lr=self.config.online_lr)\n\n        self.seq_buffer  = SequenceReplayBuffer()\n        self.gru_seq_buf = GRUSequenceBuffer()\n\n        self._interaction_history: List[Tuple[int,int]] = []\n        self._current_opp_idx: int = 0\n        self._current_regime:  int = REGIME_RANDOM\n        self._ep_seqs: List[np.ndarray] = []\n        self._round_in_ep: int = 0\n        self._log_posterior: Optional[torch.Tensor] = None\n\n        self._payoff_t  = PAYOFF_TENSOR.to(device)\n\n        # FIX 3: track posterior entropy for shaping weight\n        self._H0 = float(np.log(N_OPPONENTS))\n        self._H_t = self._H0\n\n    def _build_slow_seq(self, history):\n        W    = TRANSFORMER_WINDOW\n        hist = history[-W:]\n        pad  = [(0, 0)] * (W - len(hist))\n        return np.array(pad + list(hist), dtype=np.float32)\n\n    def _build_fast_seq(self, history):\n        W    = FAST_WINDOW\n        hist = history[-W:]\n        pad  = [(0, 0)] * (W - len(hist))\n        return np.array(pad + list(hist), dtype=np.float32)\n\n    def _compute_shaping_weight(self, posterior: torch.Tensor) -> float:\n        \"\"\"FIX 3: entropy-scaled shaping weight.\"\"\"\n        H = float(-(posterior * (posterior + 1e-8).log()).sum())\n        self._H_t = H\n        reduction = max(0.0, (self._H0 - H) / self._H0)\n        return self.config.shape_lambda_max * reduction\n\n    def _compute_epsilon(self) -> float:\n        \"\"\"FIX 2: per-episode decay (resets each episode).\"\"\"\n        t = self._round_in_ep\n        eps = self.config.eps_end + (self.config.eps_start - self.config.eps_end) * \\\n              np.exp(-t / self.config.eps_episode_decay)\n        return eps\n\n    @property\n    def epsilon(self): return self._compute_epsilon()\n\n    def select_action(self, base_obs, eval_mode=False):\n        # FIX 2: always cooperate on round 0\n        if self._round_in_ep == 0:\n            return C\n\n        eps = self._compute_epsilon()\n        if not eval_mode and self._rng.random() < eps:\n            return self._rng.randint(0, ACTION_DIM-1)\n\n        slow_seq  = self._build_slow_seq(self._interaction_history)\n        fast_seq  = self._build_fast_seq(self._interaction_history)\n        slow_t    = torch.tensor(slow_seq,  dtype=torch.float32).unsqueeze(0).to(device)\n        fast_t    = torch.tensor(fast_seq,  dtype=torch.float32).unsqueeze(0).to(device)\n        obs_t     = torch.tensor(base_obs,  dtype=torch.float32).unsqueeze(0).to(device)\n        round_feat= make_round_features(self._round_in_ep).unsqueeze(0).to(device)\n\n        with torch.no_grad():\n            q_mixed, slow_z, class_logits, regime_w = self.policy_net(obs_t, slow_t, fast_t)\n\n            # Update rolling posterior\n            if self._log_posterior is None:\n                self._log_posterior = torch.zeros(1, N_OPPONENTS, device=device)\n            self._log_posterior = self._log_posterior + F.log_softmax(class_logits, dim=-1)\n            self._log_posterior = self._log_posterior - self._log_posterior.logsumexp(dim=-1, keepdim=True)\n            posterior = torch.exp(self._log_posterior)\n\n            # FIX 4: online correction\n            q_corr = self.online_corr(slow_z, round_feat)\n            q_final = q_mixed + self.config.online_correction_weight * q_corr\n\n            # FIX 3: entropy-scaled exp_r shaping\n            shaping_w = self._compute_shaping_weight(posterior)\n            if shaping_w > 0.01:\n                exp_r = self.policy_net.bayes_head.expected_reward(posterior, self._payoff_t)\n                q_final = q_final + shaping_w * exp_r\n\n        return int(q_final.argmax(dim=-1).item())\n\n    def push(self, base_obs, action, reward, next_base_obs, done):\n        slow_seq  = self._build_slow_seq(self._interaction_history[:-1])\n        fast_seq  = self._build_fast_seq(self._interaction_history[:-1])\n        next_slow = self._build_slow_seq(self._interaction_history)\n        next_fast = self._build_fast_seq(self._interaction_history)\n        self.seq_buffer.push(slow_seq, fast_seq, base_obs, action, reward,\n                             next_slow, next_fast, next_base_obs, done,\n                             self._current_opp_idx, self._current_regime)\n        self._ep_seqs.append(slow_seq.copy())\n\n        # FIX 4: online update on every step\n        self._online_update(slow_seq, fast_seq, base_obs, action, reward,\n                            next_slow, next_fast, next_base_obs, done)\n\n    def _online_update(self, slow_seq, fast_seq, base_obs, action, reward,\n                       next_slow, next_fast, next_base_obs, done):\n        \"\"\"FIX 4: lightweight online Q-correction update.\"\"\"\n        with torch.no_grad():\n            ns_t  = torch.tensor(next_slow, dtype=torch.float32).unsqueeze(0).to(device)\n            nf_t  = torch.tensor(next_fast, dtype=torch.float32).unsqueeze(0).to(device)\n            nb_t  = torch.tensor(next_base_obs, dtype=torch.float32).unsqueeze(0).to(device)\n            rf_n  = make_round_features(self._round_in_ep + 1).unsqueeze(0).to(device)\n            nq, nz, _, _ = self.target_net(nb_t, ns_t, nf_t)\n            nq_corr = self.online_corr(nz, rf_n)\n            nq_final = nq + self.config.online_correction_weight * nq_corr\n            next_q   = nq_final.max(1)[0].item()\n            target   = reward + self.config.gamma * next_q * (1.0 - float(done))\n\n        s_t   = torch.tensor(slow_seq,  dtype=torch.float32).unsqueeze(0).to(device)\n        f_t   = torch.tensor(fast_seq,  dtype=torch.float32).unsqueeze(0).to(device)\n        b_t   = torch.tensor(base_obs,  dtype=torch.float32).unsqueeze(0).to(device)\n        rf_t  = make_round_features(self._round_in_ep).unsqueeze(0).to(device)\n\n        with torch.no_grad():\n            q_base, sz, _, _ = self.policy_net(b_t, s_t, f_t)\n        q_corr = self.online_corr(sz.detach(), rf_t)\n        q_val  = (q_base + self.config.online_correction_weight * q_corr)[0, action]\n        loss   = F.smooth_l1_loss(q_val, torch.tensor(target, device=device))\n\n        self.online_opt.zero_grad()\n        loss.backward()\n        torch.nn.utils.clip_grad_norm_(self.online_corr.parameters(), 0.5)\n        self.online_opt.step()\n\n    def train_step(self):\n        if len(self.seq_buffer) < self.config.batch_size:\n            return {}\n\n        batch, opp_ids = self.seq_buffer.sample(self.config.batch_size)\n        B = self.config.batch_size\n\n        SLOW = torch.tensor(np.array(batch.slow_seq),      dtype=torch.float32).to(device)\n        FAST = torch.tensor(np.array(batch.fast_seq),      dtype=torch.float32).to(device)\n        OBS  = torch.tensor(np.array(batch.base_obs),      dtype=torch.float32).to(device)\n        A    = torch.tensor(batch.action,                   dtype=torch.long).to(device)\n        R    = torch.tensor(batch.reward,                   dtype=torch.float32).to(device)\n        NSLOW= torch.tensor(np.array(batch.next_slow),     dtype=torch.float32).to(device)\n        NFAST= torch.tensor(np.array(batch.next_fast),     dtype=torch.float32).to(device)\n        NOBS = torch.tensor(np.array(batch.next_base_obs), dtype=torch.float32).to(device)\n        DN   = torch.tensor(batch.done,                    dtype=torch.float32).to(device)\n\n        q_mixed, slow_z, class_logits, regime_w = self.policy_net(OBS, SLOW, FAST)\n        posterior = torch.softmax(class_logits, dim=-1)\n\n        # FIX 3: batch shaping (use mean entropy across batch)\n        H_batch   = -(posterior * (posterior + 1e-8).log()).sum(dim=-1).mean()\n        H0        = float(np.log(N_OPPONENTS))\n        shaping_w = float(self.config.shape_lambda_max * max(0.0, (H0 - H_batch.item()) / H0))\n\n        exp_r     = self.policy_net.bayes_head.expected_reward(posterior, self._payoff_t)\n        q_shaped  = q_mixed + shaping_w * exp_r.detach()\n        q_vals    = q_shaped.gather(1, A.unsqueeze(1)).squeeze(1)\n\n        with torch.no_grad():\n            nq_pol, _, nlogits, _ = self.policy_net(NOBS, NSLOW, NFAST)\n            n_post    = torch.softmax(nlogits, dim=-1)\n            n_exp_r   = self.policy_net.bayes_head.expected_reward(n_post, self._payoff_t)\n            nq_shaped = nq_pol + shaping_w * n_exp_r\n            next_acts = nq_shaped.argmax(1)\n\n            nq_tgt, _, _, _ = self.target_net(NOBS, NSLOW, NFAST)\n            next_q   = nq_tgt.gather(1, next_acts.unsqueeze(1)).squeeze(1)\n            targets  = R + self.config.gamma * next_q * (1 - DN)\n\n        td_loss = F.smooth_l1_loss(q_vals, targets)\n\n        opp_ids_t  = torch.tensor(opp_ids, dtype=torch.long, device=device)\n        bayes_loss = F.cross_entropy(class_logits, opp_ids_t)\n\n        contrast_loss = torch.tensor(0.0, device=device)\n        neg_seqs_np   = self.gru_seq_buf.sample_negatives_batch(opp_ids, self.config.n_negatives)\n\n        if neg_seqs_np is not None:\n            opp_ids_t2    = torch.tensor(opp_ids, dtype=torch.long, device=device)\n            same_opp_mask = (opp_ids_t2.unsqueeze(0) == opp_ids_t2.unsqueeze(1))\n            same_opp_mask.fill_diagonal_(False)\n            pos_idx = torch.arange(B, device=device)\n            for i in range(B):\n                candidates = same_opp_mask[i].nonzero(as_tuple=True)[0]\n                if len(candidates) > 0:\n                    pos_idx[i] = candidates[torch.randint(len(candidates),(1,),device=device)]\n                else:\n                    pos_idx[i] = (i + 1) % B\n\n            pos_seq   = SLOW[pos_idx]\n            z_anchor  = self.policy_net.encode_seq(SLOW)\n            z_pos     = self.policy_net.encode_seq(pos_seq)\n            z_anc_act = self.policy_net.encode_with_action(z_anchor, A)\n            z_pos_act = self.policy_net.encode_with_action(z_pos, A[pos_idx])\n\n            K     = self.config.n_negatives\n            neg_t = torch.tensor(neg_seqs_np, dtype=torch.float32).to(device)\n            neg_t = neg_t.view(B * K, TRANSFORMER_WINDOW, 2)\n            z_neg = self.policy_net.encode_seq(neg_t)\n            A_rep = A.repeat_interleave(K)\n            z_neg_act = self.policy_net.encode_with_action(z_neg, A_rep)\n            z_neg_act = z_neg_act.view(B, K, -1)\n\n            contrast_loss = info_nce_loss(\n                z_anc_act, z_pos_act, z_neg_act,\n                temperature=self.config.contrast_tau\n            )\n\n        total_loss = (td_loss\n                      + self.config.bayes_lambda   * bayes_loss\n                      + self.config.contrast_lambda * contrast_loss)\n\n        self.optimizer.zero_grad()\n        total_loss.backward()\n        torch.nn.utils.clip_grad_norm_(self.policy_net.parameters(), 1.0)\n        self.optimizer.step()\n\n        self.steps += 1\n        if self.steps % self.config.target_update_freq == 0:\n            self.target_net.load_state_dict(self.policy_net.state_dict())\n\n        return {\n            'loss':          td_loss.item(),\n            'bayes_loss':    bayes_loss.item(),\n            'contrast_loss': float(contrast_loss) if isinstance(contrast_loss, torch.Tensor) else 0.0,\n            'shaping_w':     shaping_w,\n        }\n\n    def on_episode_start(self):\n        self.total_episodes += 1\n        self._interaction_history = []\n        self._ep_seqs             = []\n        self._round_in_ep         = 0\n        self._log_posterior       = None\n        self._H_t                 = self._H0\n        # FIX 4: reset online correction each episode\n        self.online_corr.reset()\n        # Reset online optimizer state too\n        self.online_opt = optim.Adam(self.online_corr.parameters(), lr=self.config.online_lr)\n\n    def on_episode_end(self):\n        if self._ep_seqs:\n            for i in range(0, len(self._ep_seqs), 2):\n                self.gru_seq_buf.push(self._ep_seqs[i], self._current_opp_idx)\n\n    def on_step(self, action, opp_action, true_idx=-1):\n        self._interaction_history.append((action, opp_action))\n        if true_idx >= 0:\n            self._current_opp_idx = true_idx\n            self._current_regime  = OPPONENT_REGIMES[true_idx]\n        self._round_in_ep += 1\n\n    def compute_intrinsic_reward(self, action): return 0.0\n    def build_state(self, base_obs): return base_obs\n\n\n# ─────────────────────────────────────────────────────────────────────────────\n# BARE DQN BASELINE (unchanged from v9r)\n# ─────────────────────────────────────────────────────────────────────────────\nclass BareDQNNet(nn.Module):\n    def __init__(self, state_dim, action_dim, hidden=256):\n        super().__init__()\n        self.net = nn.Sequential(\n            nn.Linear(state_dim, hidden), nn.LayerNorm(hidden), nn.ReLU(),\n            nn.Linear(hidden, hidden),    nn.LayerNorm(hidden), nn.ReLU(),\n            nn.Linear(hidden, hidden//2), nn.LayerNorm(hidden//2), nn.ReLU(),\n        )\n        self.value_head = nn.Linear(hidden//2, 1)\n        self.adv_head   = nn.Linear(hidden//2, action_dim)\n\n    def forward(self, x):\n        h=self.net(x); V=self.value_head(h); A=self.adv_head(h)\n        return V + A - A.mean(dim=-1, keepdim=True)\n\nTransition = namedtuple('Transition', ('state','action','reward','next_state','done'))\n\nclass BareDQNAgent:\n    name = \"Bare DQN\"\n    def __init__(self, hidden=256, lr=1e-3, gamma=0.98, batch_size=256,\n                 target_update_freq=10, eps_start=1.0, eps_end=0.05,\n                 eps_decay=500, buffer_size=50_000, seed=SEED):\n        self.gamma=gamma; self.batch_size=batch_size\n        self.eps_start=eps_start; self.eps_end=eps_end; self.eps_decay=eps_decay\n        self.episode_num=0; self._rng=random.Random(seed)\n        self.policy_net=BareDQNNet(STATE_DIM_BARE,ACTION_DIM,hidden).to(device)\n        self.target_net=BareDQNNet(STATE_DIM_BARE,ACTION_DIM,hidden).to(device)\n        self.target_net.load_state_dict(self.policy_net.state_dict())\n        self.target_net.eval()\n        self.opt=optim.Adam(self.policy_net.parameters(), lr=lr)\n        self.buffer=deque(maxlen=buffer_size)\n        self.target_freq=target_update_freq; self.steps=0\n\n    @property\n    def epsilon(self):\n        return self.eps_end+(self.eps_start-self.eps_end)*np.exp(-self.episode_num/self.eps_decay)\n\n    def build_state(self,base_obs): return base_obs\n\n    def select_action(self, state, eval_mode=False):\n        if not eval_mode and self._rng.random()<self.epsilon:\n            return self._rng.randint(0,ACTION_DIM-1)\n        with torch.no_grad():\n            t=torch.tensor(state,dtype=torch.float32).unsqueeze(0).to(device)\n            return int(self.policy_net(t).argmax(1).item())\n\n    def push(self, state, action, reward, next_state, done):\n        self.buffer.append(Transition(state,action,reward,next_state,float(done)))\n\n    def train_step(self):\n        if len(self.buffer)<self.batch_size: return {}\n        batch=Transition(*zip(*random.sample(list(self.buffer),self.batch_size)))\n        S =torch.tensor(np.array(batch.state),      dtype=torch.float32).to(device)\n        A =torch.tensor(batch.action,                dtype=torch.long).to(device)\n        R =torch.tensor(batch.reward,                dtype=torch.float32).to(device)\n        S2=torch.tensor(np.array(batch.next_state), dtype=torch.float32).to(device)\n        Dn=torch.tensor(batch.done,                  dtype=torch.float32).to(device)\n        q =self.policy_net(S).gather(1,A.unsqueeze(1)).squeeze(1)\n        with torch.no_grad():\n            a2=self.policy_net(S2).argmax(1)\n            nq=self.target_net(S2).gather(1,a2.unsqueeze(1)).squeeze(1)\n            tgt=R+self.gamma*nq*(1-Dn)\n        loss=F.smooth_l1_loss(q,tgt)\n        self.opt.zero_grad(); loss.backward(); self.opt.step()\n        self.steps+=1\n        if self.steps%self.target_freq==0:\n            self.target_net.load_state_dict(self.policy_net.state_dict())\n        return {'loss': loss.item()}\n\n    def compute_intrinsic_reward(self,action): return 0.0\n    def on_episode_start(self): self.episode_num+=1\n    def on_episode_end(self): pass\n    def on_step(self, action, opp_action, true_idx=-1): pass\n\n\n# ─────────────────────────────────────────────────────────────────────────────\n# RULE-BASED BASELINES\n# ─────────────────────────────────────────────────────────────────────────────\nclass TFTAgent:\n    name = \"TFT\"\n    def __init__(self): self.last_opp=C\n    def build_state(self,b): return b\n    def select_action(self,s,eval_mode=False): return self.last_opp\n    def push(self,*a): pass\n    def train_step(self): return {}\n    def on_episode_start(self): self.last_opp=C\n    def on_episode_end(self): pass\n    def on_step(self,a,o,true_idx=-1): self.last_opp=o\n    def compute_intrinsic_reward(self,a): return 0.0\n    @property\n    def epsilon(self): return 0.0\n\nclass CooperatorAgent:\n    name = \"Cooperator\"\n    def build_state(self,b): return b\n    def select_action(self,s,eval_mode=False): return C\n    def push(self,*a): pass\n    def train_step(self): return {}\n    def on_episode_start(self): pass\n    def on_episode_end(self): pass\n    def on_step(self,a,o,true_idx=-1): pass\n    def compute_intrinsic_reward(self,a): return 0.0\n    @property\n    def epsilon(self): return 0.0\n\nclass DefectorAgent:\n    name = \"Defector\"\n    def build_state(self,b): return b\n    def select_action(self,s,eval_mode=False): return D\n    def push(self,*a): pass\n    def train_step(self): return {}\n    def on_episode_start(self): pass\n    def on_episode_end(self): pass\n    def on_step(self,a,o,true_idx=-1): pass\n    def compute_intrinsic_reward(self,a): return 0.0\n    @property\n    def epsilon(self): return 0.0\n\n\n# ─────────────────────────────────────────────────────────────────────────────\n# TRAINING LOOP\n# ─────────────────────────────────────────────────────────────────────────────\ndef run_training(agent, num_episodes=2000, agent_name=\"Agent\", seed=SEED):\n    rng_ep=random.Random(seed)\n    all_rewards, all_coops, losses=[],[],[]\n    round_reward_acc  =np.zeros(ROUNDS_PER_EPISODE)\n    round_reward_count=np.zeros(ROUNDS_PER_EPISODE)\n\n    pbar=tqdm(range(1,num_episodes+1),desc=f\"Training {agent_name}\",unit=\"ep\",leave=True)\n    for ep in pbar:\n        opp_idx  =rng_ep.randint(0,N_OPPONENTS-1)\n        opp_class=OPPONENT_CLASSES[opp_idx]\n        env      =IPDEnvironment(opp_class, true_idx=opp_idx)\n        agent.on_episode_start()\n        base_obs=env.reset()\n        ep_r,ep_c=0.0,0\n        ep_round_rewards=[]\n\n        for rnd in range(ROUNDS_PER_EPISODE):\n            action=agent.select_action(base_obs)\n            next_base,reward_ext,done,info=env.step(action)\n            opp_action=info['opponent_action']\n            agent.on_step(action,opp_action,true_idx=opp_idx)\n            agent.push(base_obs,action,reward_ext,next_base,done)\n            if rnd%TRAIN_FREQ==0:\n                tr=agent.train_step()\n                if tr and 'loss' in tr: losses.append(tr['loss'])\n            ep_r+=reward_ext; ep_c+=(1-action)\n            ep_round_rewards.append(reward_ext)\n            base_obs=next_base\n            if done: break\n\n        agent.on_episode_end()\n        all_rewards.append(ep_r); all_coops.append(ep_c/ROUNDS_PER_EPISODE)\n        for t,r in enumerate(ep_round_rewards):\n            round_reward_acc[t]+=r; round_reward_count[t]+=1\n\n        if ep%100==0:\n            pbar.set_postfix({\n                'R(100)': f'{np.mean(all_rewards[-100:]):.1f}',\n                'coop':   f'{np.mean(all_coops[-100:]):.2f}',\n            })\n\n    round_reward_mean=np.where(round_reward_count>0,\n                               round_reward_acc/np.maximum(round_reward_count,1), 0.0)\n    return {'rewards': np.array(all_rewards), 'coop_rates': np.array(all_coops),\n            'losses': losses, 'round_reward_mean': round_reward_mean}\n\n\n# ─────────────────────────────────────────────────────────────────────────────\n# EVALUATION\n# ─────────────────────────────────────────────────────────────────────────────\ndef evaluate_agent(agent, num_eval_episodes=100, seed=SEED):\n    results={}\n    for opp_idx,opp_class in enumerate(OPPONENT_CLASSES):\n        opp_name=OPPONENT_NAMES[opp_idx]\n        ep_rewards,ep_coops=[],[]\n        round_r_acc=np.zeros(ROUNDS_PER_EPISODE)\n        round_r_cnt=np.zeros(ROUNDS_PER_EPISODE)\n\n        for _ in range(num_eval_episodes):\n            env=IPDEnvironment(opp_class, true_idx=opp_idx)\n            agent.on_episode_start()\n            base_obs=env.reset()\n            r_sum,coops=0.0,0\n\n            for rnd in range(ROUNDS_PER_EPISODE):\n                action=agent.select_action(base_obs, eval_mode=True)\n                next_base,reward,done,info=env.step(action)\n                opp_action=info['opponent_action']\n                agent.on_step(action,opp_action,true_idx=opp_idx)\n                round_r_acc[rnd]+=reward; round_r_cnt[rnd]+=1\n                r_sum+=reward; coops+=(1-action)\n                base_obs=next_base\n                if done: break\n\n            agent.on_episode_end()\n            ep_rewards.append(r_sum); ep_coops.append(coops/ROUNDS_PER_EPISODE)\n\n        round_mean=np.where(round_r_cnt>0, round_r_acc/np.maximum(round_r_cnt,1), 0.0)\n        results[opp_name]={\n            'avg_reward': float(np.mean(ep_rewards)),\n            'std_reward': float(np.std(ep_rewards)),\n            'coop_rate':  float(np.mean(ep_coops)),\n            'round_reward': round_mean,\n        }\n    return results\n\n\ndef compute_regret(eval_results):\n    return {opp: max(0.0, 3.0*ROUNDS_PER_EPISODE - stats['avg_reward'])\n            for opp,stats in eval_results.items()}\n\n\ndef collect_embeddings(agent, n_episodes_per_opp=20, seed=SEED):\n    if not isinstance(agent, DRQNv10Agent): return None,None,None\n    zs,labels=[],[]\n    agent.policy_net.eval()\n    for opp_idx,opp_class in enumerate(OPPONENT_CLASSES):\n        for _ in range(n_episodes_per_opp):\n            env=IPDEnvironment(opp_class, true_idx=opp_idx)\n            agent.on_episode_start(); base_obs=env.reset()\n            for rnd in range(ROUNDS_PER_EPISODE):\n                action=agent.select_action(base_obs, eval_mode=True)\n                next_base,reward,done,info=env.step(action)\n                agent.on_step(action,info['opponent_action'],true_idx=opp_idx)\n                base_obs=next_base\n                if done: break\n            seq=agent._build_slow_seq(agent._interaction_history)\n            seq_t=torch.tensor(seq,dtype=torch.float32).unsqueeze(0).to(device)\n            with torch.no_grad():\n                z=agent.policy_net.encode_seq(seq_t)\n            zs.append(z.squeeze(0).cpu().numpy()); labels.append(opp_idx)\n            agent.on_episode_end()\n    agent.policy_net.train()\n    return np.array(zs), np.array(labels), OPPONENT_NAMES\n\n\n# ─────────────────────────────────────────────────────────────────────────────\n# REPORTING\n# ─────────────────────────────────────────────────────────────────────────────\ndef print_summary_table(eval_results_dict):\n    agents=list(eval_results_dict.keys())\n    opps  =list(next(iter(eval_results_dict.values())).keys())\n    print(\"\\n\"+\"=\"*130)\n    print(\"SUMMARY — Average Reward per Agent per Opponent (full episode)\")\n    print(\"=\"*130)\n    hdr=f\"{'Opponent':<30}\"+\"\".join(f\"{ag:>22}\" for ag in agents)\n    print(hdr); print(\"-\"*len(hdr))\n    orig_opps=OPPONENT_NAMES[:N_ORIGINAL]; hard_opps=OPPONENT_NAMES[N_ORIGINAL:]\n\n    def print_section(opp_list, label):\n        print(f\"\\n  [{label}]\")\n        for opp in opp_list:\n            if opp not in opps: continue\n            vals=[eval_results_dict[ag][opp]['avg_reward'] for ag in agents]\n            best=max(vals)\n            row=f\"  {opp:<28}\"\n            for v in vals:\n                row+=f\"{v:>21.1f}{'*' if v==best else ' '}\"\n            print(row)\n\n    print_section(orig_opps,\"Original 20 opponents\")\n    print_section(hard_opps,\"Hard 8 opponents\")\n    print(\"\\n\"+\"-\"*len(hdr))\n    for label,opp_list in [(\"Original mean\",orig_opps),(\"Hard mean\",hard_opps),(\"Overall mean\",opps)]:\n        means=[np.mean([eval_results_dict[ag][o]['avg_reward']\n                        for o in opp_list if o in opps]) for ag in agents]\n        best_m=max(means)\n        row=f\"  {label:<28}\"\n        for m in means:\n            row+=f\"{m:>21.1f}{'*' if m==best_m else ' '}\"\n        print(row)\n    print(\"=\"*130)\n\n    full='DRQN+v10'\n    ablations=['Bare DQN','TFT']\n    ablations=[a for a in ablations if a in agents]\n    if full in agents and ablations:\n        print(f\"\\n{'─'*80}\")\n        print(f\"ABLATION DELTAS  (vs {full}, mean reward, + = full model better)\")\n        print(f\"{'─'*80}\")\n        for opp_group,opp_list in [(\"All\",opps),(\"Hard only\",hard_opps)]:\n            full_mean=np.mean([eval_results_dict[full][o]['avg_reward']\n                               for o in opp_list if o in opps])\n            print(f\"\\n  {opp_group}:\")\n            for abl in ablations:\n                abl_mean=np.mean([eval_results_dict[abl][o]['avg_reward']\n                                  for o in opp_list if o in opps])\n                delta=full_mean-abl_mean\n                bar='▲'*int(abs(delta)/2) if delta>0 else '▼'*int(abs(delta)/2)\n                print(f\"    {full} − {abl:<35} Δ={delta:+.1f}  {bar}\")\n\n    print(f\"\\n{'─'*80}\")\n    print(\"ADAPTATION SPEED  (mean reward rounds 1-10 vs 41-100)\")\n    print(f\"{'─'*80}\")\n    for ag in agents:\n        early=np.mean([eval_results_dict[ag][o]['round_reward'][:10].mean()\n                       for o in opps if o in eval_results_dict[ag]])\n        late =np.mean([eval_results_dict[ag][o]['round_reward'][40:].mean()\n                       for o in opps if o in eval_results_dict[ag]])\n        gap=late-early\n        print(f\"  {ag:<35}  early={early:.2f}  late={late:.2f}  gap(late-early)={gap:+.2f}\")\n    print(f\"{'─'*80}\")\n\n\n# ─────────────────────────────────────────────────────────────────────────────\n# PLOTS (adapted from v9r)\n# ─────────────────────────────────────────────────────────────────────────────\ndef plot_all(train_stats, eval_results, regret_dict, embeddings_data=None,\n             output_dir='/kaggle/working'):\n    os.makedirs(output_dir, exist_ok=True)\n    sns.set_style(\"whitegrid\")\n\n    COLORS={\n        'DRQN+v10':   '#1565C0',\n        'Bare DQN':   '#EF5350',\n        'TFT':        '#43A047',\n        'Cooperator': '#FFA726',\n        'Defector':   '#78909C',\n    }\n\n    agents_list=list(eval_results.keys())\n    opps       =list(eval_results[agents_list[0]].keys())\n    orig_opps  =[o for o in opps if o in OPPONENT_NAMES[:N_ORIGINAL]]\n    hard_opps  =[o for o in opps if o in OPPONENT_NAMES[N_ORIGINAL:]]\n    learners   =[a for a in ['DRQN+v10','Bare DQN'] if a in agents_list]\n\n    def sm(arr,w=50):\n        return np.convolve(arr,np.ones(w)/w,mode='valid') if len(arr)>=w else arr\n\n    # 1. Training curves\n    fig,axes=plt.subplots(1,2,figsize=(15,5))\n    for name in learners:\n        if name not in train_stats: continue\n        c=COLORS.get(name,'gray')\n        axes[0].plot(sm(train_stats[name]['rewards'],80), label=name,color=c,lw=2)\n        axes[1].plot(sm(train_stats[name]['coop_rates'],80),label=name,color=c,lw=2)\n    for ax,title,ylabel in zip(axes,\n        [\"Training reward (smoothed w=80)\",\"Cooperation rate (smoothed)\"],\n        [\"Total reward\",\"Cooperation rate\"]):\n        ax.set_xlabel(\"Episode\"); ax.set_ylabel(ylabel)\n        ax.set_title(title); ax.legend(fontsize=9); ax.grid(alpha=0.3)\n    plt.tight_layout()\n    show_figure(f'{output_dir}/01_training_curves.png',\"Training Curves\")\n\n    # 2. Per-round adaptation\n    fig,axes=plt.subplots(1,2,figsize=(16,6))\n    rounds=np.arange(1,ROUNDS_PER_EPISODE+1)\n    for panel,opp_set,title in [\n        (axes[0],opps,     \"Per-round reward — ALL opponents\"),\n        (axes[1],hard_opps,\"Per-round reward — HARD opponents\"),\n    ]:\n        for name in learners+['TFT']:\n            if name not in eval_results or not opp_set: continue\n            mean_curve=np.mean([eval_results[name][o]['round_reward'] for o in opp_set],axis=0)\n            sm_curve  =np.convolve(mean_curve,np.ones(5)/5,mode='same')\n            panel.plot(rounds,sm_curve,label=name,color=COLORS.get(name,'gray'),lw=2)\n        panel.axvspan(1,10,alpha=0.07,color='gold',label='Early (1-10)')\n        panel.set_title(title); panel.set_xlabel(\"Round\")\n        panel.set_ylabel(\"Mean reward\"); panel.legend(fontsize=8); panel.grid(alpha=0.3)\n    plt.tight_layout()\n    show_figure(f'{output_dir}/02_per_round_adaptation.png',\"Per-Round Adaptation\")\n\n    # 3. Ablation bar\n    abl_present=[a for a in ['DRQN+v10','Bare DQN','TFT','Cooperator','Defector']\n                 if a in agents_list]\n    fig,axes=plt.subplots(1,2,figsize=(14,6))\n    for ax,opp_set,title in [\n        (axes[0],opps,     \"Mean reward — All 28 opponents\"),\n        (axes[1],hard_opps,\"Mean reward — Hard 8 opponents\"),\n    ]:\n        means=[np.mean([eval_results[ag][o]['avg_reward']\n                        for o in opp_set if o in eval_results[ag]]) for ag in abl_present]\n        stds =[np.std([eval_results[ag][o]['avg_reward']\n                       for o in opp_set if o in eval_results[ag]])/np.sqrt(max(1,len(opp_set)))\n               for ag in abl_present]\n        bars=ax.bar(range(len(abl_present)),means,yerr=stds,capsize=4,\n                    color=[COLORS.get(a,'gray') for a in abl_present],\n                    edgecolor='white',linewidth=1.2)\n        ax.set_xticks(range(len(abl_present)))\n        ax.set_xticklabels(abl_present,rotation=20,ha='right',fontsize=9)\n        ax.set_ylabel(\"Mean episode reward\"); ax.set_title(title); ax.grid(axis='y',alpha=0.3)\n        for bar,m in zip(bars,means):\n            ax.text(bar.get_x()+bar.get_width()/2, m+1,\n                    f\"{m:.0f}\", ha='center',va='bottom',fontsize=9,fontweight='bold')\n    plt.tight_layout()\n    show_figure(f'{output_dir}/03_ablation_bar.png',\"Ablation — Mean Reward\")\n\n    # 4. Per-opponent bar\n    plot_agents=[a for a in ['DRQN+v10','Bare DQN','TFT'] if a in agents_list]\n    fig,ax=plt.subplots(figsize=(22,8))\n    x=np.arange(len(opps)); width=0.28\n    for i,ag in enumerate(plot_agents):\n        vals=[eval_results[ag][o]['avg_reward'] for o in opps]\n        errs=[eval_results[ag][o]['std_reward']  for o in opps]\n        ax.bar(x+i*width,vals,width,yerr=errs,label=ag,capsize=2,\n               alpha=0.85,color=COLORS.get(ag,f'C{i}'))\n    ax.axvline(N_ORIGINAL-0.5,color='black',ls='--',lw=1.5,alpha=0.5,label='Original | Hard split')\n    ax.set_xticks(x+width); ax.set_xticklabels([o[:18] for o in opps],rotation=45,ha='right',fontsize=7.5)\n    ax.set_ylabel(\"Average reward\"); ax.set_title(\"Per-opponent performance v10\")\n    ax.legend(); ax.grid(axis='y',alpha=0.3)\n    plt.tight_layout()\n    show_figure(f'{output_dir}/04_per_opponent.png',\"Per-Opponent Performance\")\n\n    # 5. Regret heatmap\n    all_agents=[a for a in agents_list if a in COLORS]\n    rm=[[regret_dict[ag][o] for o in opps] for ag in all_agents if ag in regret_dict]\n    row_labels=[ag for ag in all_agents if ag in regret_dict]\n    fig,ax=plt.subplots(figsize=(20,max(4,len(row_labels)*0.9)))\n    im=ax.imshow(rm,cmap='RdYlGn_r',aspect='auto',vmin=0,vmax=200)\n    ax.set_xticks(np.arange(len(opps))); ax.set_yticks(np.arange(len(row_labels)))\n    ax.set_xticklabels([o[:15] for o in opps],rotation=45,ha='right',fontsize=7)\n    ax.set_yticklabels(row_labels,fontsize=9)\n    ax.axvline(N_ORIGINAL-0.5,color='white',lw=2,ls='--',alpha=0.7)\n    ax.set_title(\"Regret heatmap v10 (lower = better)\")\n    plt.colorbar(im,ax=ax,label=\"Regret\"); plt.tight_layout()\n    show_figure(f'{output_dir}/05_regret_heatmap.png',\"Regret Heatmap\")\n\n    # 6. t-SNE embeddings\n    if embeddings_data is not None:\n        zs,labels,opp_names=embeddings_data\n        if zs is not None and len(zs)>0:\n            try:\n                from sklearn.manifold import TSNE\n                tsne  =TSNE(n_components=2,perplexity=30,random_state=SEED,\n                            n_iter=1000,learning_rate='auto',init='pca')\n                zs_2d =tsne.fit_transform(zs)\n                fig,ax=plt.subplots(figsize=(14,10))\n                cmap_orig=plt.cm.get_cmap('tab20',N_ORIGINAL)\n                cmap_hard=plt.cm.get_cmap('Set1', N_HARD)\n                for oi in range(N_OPPONENTS):\n                    mask=(labels==oi)\n                    if not mask.any(): continue\n                    is_hard=oi>=N_ORIGINAL\n                    color=cmap_hard(oi-N_ORIGINAL) if is_hard else cmap_orig(oi)\n                    ax.scatter(zs_2d[mask,0],zs_2d[mask,1],c=[color],\n                               label=opp_names[oi],\n                               marker='D' if is_hard else 'o',\n                               s=35,alpha=0.75,edgecolors='none')\n                ax.set_title(\"t-SNE — DRQN+v10\")\n                ax.set_xlabel(\"t-SNE dim 1\"); ax.set_ylabel(\"t-SNE dim 2\")\n                ax.legend(bbox_to_anchor=(1.01,1),loc='upper left',fontsize=7,ncol=1,markerscale=1.5)\n                plt.tight_layout()\n                show_figure(f'{output_dir}/06_tsne_embeddings.png',\"t-SNE Embeddings\")\n            except ImportError:\n                print(\"  [SKIP] sklearn not available\")\n\n\n# ─────────────────────────────────────────────────────────────────────────────\n# MAIN\n# ─────────────────────────────────────────────────────────────────────────────\nif __name__ == \"__main__\":\n    t0=time.time()\n    NUM_TRAIN  = 2000\n    NUM_EVAL   = 100\n    OUTPUT_DIR = '/kaggle/working'\n\n    print(\"\\n\"+\"=\"*70)\n    print(\"DRQN v10 — Posterior-Gated Q-Mixture + C-Prior + Online Correction\")\n    print(\"=\"*70)\n    print(f\"Opponent pool:        {N_OPPONENTS} ({N_ORIGINAL} original + {N_HARD} hard)\")\n    print(f\"Training episodes:    {NUM_TRAIN}\")\n    print(f\"Eval episodes:        {NUM_EVAL} per opponent\")\n    print(f\"State dim:            {STATE_DIM_DRQN}\")\n    print(f\"FIX 1: Regime Q-mixture ({N_REGIMES} heads), posterior-gated\")\n    print(f\"FIX 2: C-first prior, per-episode epsilon (eps_start=0.30)\")\n    print(f\"FIX 3: Entropy-scaled shaping, λ_max={SHAPE_LAMBDA_MAX}\")\n    print(f\"FIX 4: Online Q-correction (lr={ONLINE_LR}), replaces MetaAdapter\")\n    print(f\"FIX 5: Regime-aware replay sampling (coop-punishing x1.5)\")\n    print(\"=\"*70)\n\n    config=DRQNv10Config(\n        hidden_size        = 256,\n        slow_dim           = SLOW_HIDDEN_DIM,\n        fast_dim           = FAST_HIDDEN_DIM,\n        lr                 = 1e-4,\n        gamma              = 0.98,\n        batch_size         = 256,\n        target_update_freq = 8,\n        eps_start          = 0.30,\n        eps_end            = 0.01,\n        eps_episode_decay  = 20,\n        bayes_lambda       = 0.15,\n        contrast_lambda    = 0.20,\n        contrast_tau       = 0.03,\n        n_negatives        = 12,\n        shape_lambda_max   = SHAPE_LAMBDA_MAX,\n        online_lr          = ONLINE_LR,\n        online_correction_weight = 0.5,\n        seed               = SEED,\n    )\n\n    agents={\n        'DRQN+v10':  DRQNv10Agent(config),\n        'Bare DQN':  BareDQNAgent(seed=SEED),\n        'TFT':       TFTAgent(),\n        'Cooperator':CooperatorAgent(),\n        'Defector':  DefectorAgent(),\n    }\n\n    print(\"\\n\"+\"=\"*60)\n    print(\"TRAINING PHASE\")\n    print(\"=\"*60)\n\n    train_stats={}\n    for name,agent in agents.items():\n        if name in ['DRQN+v10','Bare DQN']:\n            train_stats[name]=run_training(agent,NUM_TRAIN,name,seed=SEED)\n        else:\n            train_stats[name]={\n                'rewards':np.zeros(1),'coop_rates':np.zeros(1),\n                'losses':[],'round_reward_mean':np.zeros(ROUNDS_PER_EPISODE),\n            }\n\n    print(\"\\n\"+\"=\"*60)\n    print(\"EVALUATION PHASE\")\n    print(\"=\"*60)\n\n    eval_results={}\n    for name,agent in tqdm